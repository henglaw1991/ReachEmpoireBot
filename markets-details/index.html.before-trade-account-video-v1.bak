<style>
:root{--gold:#f5b026;--black:#050505;--ink:#111;--muted:#666;--line:#e8e2d6;--soft:#fff8ea;--bg:#fff}
*{box-sizing:border-box}html,body{width:100%;max-width:100%;overflow-x:hidden}body{margin:0;font-family:Ubuntu,Arial,sans-serif;color:var(--ink);background:#fff}a{text-decoration:none;color:inherit}img{max-width:100%}
.reb-top{background:#101312;color:#fff;padding:16px 7vw;display:flex;align-items:center;justify-content:space-between;gap:18px}.reb-phone{font-size:20px;font-weight:700}.reb-phone i{color:var(--gold);margin-right:10px}.reb-actions{display:flex;gap:10px}.reb-actions a{border:1px solid rgba(255,255,255,.45);border-radius:8px;padding:10px 22px;font-weight:700}.reb-actions a:first-child{background:var(--gold);border-color:var(--gold);color:#070707}
.reb-header{padding:18px 7vw;border-bottom:1px solid #eee;background:#fff;display:flex;align-items:center;justify-content:space-between;gap:26px;position:sticky;top:0;z-index:20}.reb-logo img{width:250px;max-width:52vw;height:auto;display:block}.reb-nav{display:flex;align-items:center;justify-content:flex-end;gap:4px;flex-wrap:nowrap;max-width:100%;min-width:0;background:#101312;border:1px solid rgba(245,176,38,.24);border-radius:14px;padding:6px;box-shadow:0 14px 30px rgba(0,0,0,.12)}.reb-nav a{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 18px;border:0;border-radius:10px;color:#fff;font-size:15px;font-weight:800;line-height:1;white-space:nowrap}.reb-nav a.active,.reb-nav a:hover{background:var(--gold);color:#070707;box-shadow:inset 0 -2px 0 rgba(0,0,0,.18)}
.reb-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;border-radius:8px;padding:0 22px;font-weight:800;border:0;cursor:pointer}.reb-btn.gold{background:var(--gold);color:#070707}.reb-btn.dark{background:#050505;color:#fff}.reb-btn.light{border:1px solid #eadfcd;background:#fff;color:#111}
.detail-hero{background:linear-gradient(180deg,#f6f8fb 0%,#fff 100%);color:#111;padding:46px 7vw 30px}.detail-wrap{max-width:1320px;margin:auto}.detail-crumb{display:flex;gap:10px;align-items:center;color:#6b7280;font-size:14px;margin-bottom:24px}.detail-crumb a{color:#a36f00;font-weight:900}.detail-product-shell{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(330px,.52fr);gap:30px;align-items:start}.detail-media-card{position:relative;border:1px solid #dfe6ef;border-radius:16px;background:#fff;box-shadow:0 18px 48px rgba(15,23,42,.08);overflow:hidden}.detail-media-card img{width:100%;aspect-ratio:16/10;object-fit:cover;background:#111;display:block}.detail-media-badge{position:absolute;left:24px;top:24px;z-index:1;background:rgba(5,5,5,.76);color:#fff;border:1px solid rgba(255,255,255,.28);border-radius:999px;padding:9px 15px;font-size:12px;font-weight:900;text-transform:uppercase}.detail-media-caption{position:absolute;left:0;right:0;bottom:0;padding:72px 32px 28px;color:#fff;background:linear-gradient(180deg,rgba(0,0,0,0),rgba(0,0,0,.78))}.detail-media-caption h1{font-size:44px;line-height:1.05;margin:0 0 10px;text-shadow:0 2px 18px rgba(0,0,0,.42)}.detail-media-caption p{max-width:720px;margin:0;color:rgba(255,255,255,.82);font-size:17px;line-height:1.55}.price-panel{border:1px solid #dfe6ef;border-radius:16px;background:#fff;padding:30px;box-shadow:0 18px 48px rgba(15,23,42,.08);position:sticky;top:116px}.price-panel .badge{display:inline-flex;align-items:center;gap:8px;color:#a36f00;background:#fff8ea;border:1px solid #f3d393;border-radius:999px;padding:8px 13px;font-size:12px;font-weight:900;text-transform:uppercase}.detail-price{display:flex;align-items:flex-end;gap:9px;margin:18px 0;color:#111}.detail-price strong{font-size:48px;line-height:1;color:#079669}.detail-price span{color:#667085;font-weight:800;margin-bottom:7px}.pricing-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:20px 0 12px;color:#101828;font-size:14px;font-weight:900;text-transform:uppercase;letter-spacing:.04em}.pricing-title:after{content:"Choose plan";border:1px solid #f3d393;background:#fff8ea;color:#a36f00;border-radius:999px;padding:5px 10px;font-size:11px;letter-spacing:0}.price-options{display:grid;gap:12px;margin:0 0 20px}.price-option{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;border:1px solid #dfe6ef;border-radius:14px;background:linear-gradient(180deg,#fff,#fbfcff);padding:15px 16px;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}.price-option:hover{border-color:#f5b026;box-shadow:0 12px 28px rgba(15,23,42,.09);transform:translateY(-1px)}.price-option.featured{border-color:#f5b026;background:linear-gradient(135deg,#fff8ea 0%,#fff 58%);box-shadow:0 14px 30px rgba(245,176,38,.14)}.price-option.featured:after{content:"Best Value";position:absolute;right:14px;top:-10px;background:#101312;color:#fff;border-radius:999px;padding:4px 9px;font-size:10px;font-weight:900;text-transform:uppercase}.price-option span{display:block;color:#101828;font-size:14px;font-weight:900;text-transform:uppercase}.price-option small{display:block;margin-top:5px;color:#667085;font-size:12px;line-height:1.35;text-transform:none}.price-option b{color:#101828;font-size:26px;line-height:1;white-space:nowrap}.price-note{margin:-8px 0 20px;color:#667085;font-size:12px;line-height:1.45}.detail-rating{display:flex;align-items:center;gap:10px;margin:8px 0 22px;color:#101828;font-weight:800}.detail-rating .stars{color:#f5b026;letter-spacing:1px}.benefit-list{display:grid;gap:13px;margin:0 0 24px;padding:0;list-style:none}.benefit-list li{display:grid;grid-template-columns:26px minmax(0,1fr);gap:10px;align-items:start;color:#344054;line-height:1.45}.benefit-check{width:22px;height:22px;border:2px solid #2563eb;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#2563eb;font-size:13px;font-weight:900;margin-top:1px}.detail-actions{display:grid;gap:12px;margin-top:18px}.detail-actions .reb-btn{width:100%;min-height:58px}.detail-actions.two{grid-template-columns:1fr 1fr}.detail-actions.two .reb-btn{min-height:52px}.youtube-play-btn{border-color:#ffd1d1!important;color:#d90000!important}.youtube-play-btn i{color:#ff0000;font-size:18px}.download-locked{background:#fff1f2!important;border:1px solid #fecdd3!important;color:#b91c1c!important}.download-ready{background:#1d4ed8!important;color:#fff!important;box-shadow:0 14px 28px rgba(29,78,216,.22)}.detail-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:22px}.detail-meta div{border:1px solid #ece7dc;background:#fffaf0;border-radius:10px;padding:13px}.detail-meta span{display:block;color:#8a5d00;font-size:12px;font-weight:900;text-transform:uppercase}.detail-meta b{display:block;margin-top:5px;color:#111}
.detail-section{padding:34px 7vw 64px;background:#fff}.detail-section.alt{background:#f6f8fb}.section-head{max-width:1320px;margin:0 auto 26px;display:flex;align-items:flex-end;justify-content:space-between;gap:18px}.section-head span{display:inline-block;color:#a36f00;background:#fff8ea;border:1px solid #f4d9a7;border-radius:999px;padding:7px 18px;font-size:12px;font-weight:900;text-transform:uppercase}.section-head h2{font-size:36px;margin:14px 0 0}.section-head p{max-width:620px;color:#667085;line-height:1.6;margin:0}
.detail-layout{max-width:1320px;margin:auto;display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:30px;align-items:start}.detail-left-stack{display:grid;gap:22px}.detail-inline-info{display:grid;gap:18px}.detail-tabs{display:flex;gap:26px;border-bottom:1px solid #dfe6ef;margin-bottom:6px;overflow-x:auto}.detail-tabs a{padding:0 0 16px;color:#667085;font-weight:900;white-space:nowrap}.detail-tabs a.active{color:#1d4ed8;border-bottom:3px solid #1d4ed8}.info-card{border:1px solid #dfe6ef;border-radius:16px;background:#fff;padding:30px;box-shadow:0 18px 44px rgba(15,23,42,.06)}.info-card h3{font-size:28px;margin:0 0 16px}.info-card p{color:#344054;line-height:1.75;margin:0}.product-copy{font-size:18px}.ea-description-content{display:grid;gap:9px;color:#344054;line-height:1.65}.ea-info-line{display:block;min-width:0;overflow-wrap:anywhere}.feature-list{display:grid;gap:12px;margin-top:22px}.feature-list div{display:grid;grid-template-columns:38px 1fr;gap:12px;align-items:start;border-top:1px solid #eef2f6;padding-top:14px}.feature-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:#eff6ff;color:#1d4ed8;font-size:18px;font-weight:900}.feature-list b{display:block;margin-bottom:3px}.feature-list small{color:#667085;line-height:1.45}.disclaimer-divider{height:1px;background:#dfe6ef;margin:26px 0}.disclaimer-block{background:#fff;border:0;border-radius:0;padding:0}.disclaimer-block h3{font-size:28px;margin:0 0 16px;color:#111}.disclaimer-block h4{font-size:20px;margin:20px 0 10px;color:#111}.disclaimer-block p{display:block;color:#344054;line-height:1.7;margin:0 0 16px;overflow-wrap:anywhere}.disclaimer-block ul{display:grid;gap:8px;margin:14px 0 18px;padding-left:22px;color:#344054;line-height:1.55}.disclaimer-block li{padding-left:4px}.disclaimer-block .final-note{margin-top:20px;margin-bottom:0;font-weight:900;color:#111}.detail-layout>div:first-child>.detail-tabs,.detail-layout>div:first-child>.info-card{display:none}.sidebar-stack{display:grid;gap:18px}.price-panel .sidebar-stack{margin-top:18px}.price-panel .spec-card,.price-panel .broker-reco{box-shadow:none;background:#fff;border-color:#e7edf5}.spec-card{border:1px solid #dfe6ef;border-radius:16px;background:#fff;padding:24px;box-shadow:0 18px 44px rgba(15,23,42,.06)}.spec-card h3{font-size:22px;margin:0 0 14px}.spec-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 0;border-top:1px solid #eef2f6;color:#667085}.spec-row:first-of-type{border-top:0}.spec-row b{color:#111;text-align:right}.broker-reco{border:1px solid #dfe6ef;border-radius:16px;background:#fff;padding:24px;box-shadow:0 18px 44px rgba(15,23,42,.06);display:grid;gap:16px}.broker-reco-head{display:grid;grid-template-columns:58px minmax(0,1fr);gap:14px;align-items:center}.broker-reco-logo{width:58px;height:58px;border-radius:12px;background:#101312;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 24px rgba(15,23,42,.18)}.broker-reco-logo img{width:46px;height:46px;object-fit:contain}.broker-reco small{color:#1d4ed8;font-weight:900;text-transform:uppercase;letter-spacing:.04em}.broker-reco h3{font-size:22px;line-height:1.18;margin:3px 0 0}.broker-reco p{color:#667085;line-height:1.55;margin:0}.broker-reco-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.broker-reco-stats div{border:1px solid #dfe6ef;border-radius:10px;padding:11px 8px;text-align:center}.broker-reco-stats span{display:block;color:#667085;font-size:11px;font-weight:900;text-transform:uppercase}.broker-reco-stats b{display:block;margin-top:4px;color:#101828;white-space:nowrap;font-size:15px}.broker-reco .reb-btn{min-height:56px;box-shadow:0 14px 28px rgba(37,99,235,.22)}.broker-risk{font-size:12px;color:#98a2b3;text-align:center}.setup-cta{display:grid;gap:12px;border:1px solid #dfe6ef;border-radius:16px;background:#fff;padding:24px;box-shadow:0 18px 44px rgba(15,23,42,.06)}.setup-cta .icon{width:48px;height:48px;border-radius:12px;background:#101312;display:flex;align-items:center;justify-content:center}.setup-cta .icon:before{content:"";width:18px;height:18px;border:2px solid #f5b026;border-radius:5px;box-shadow:inset 0 0 0 4px #101312}.setup-cta h3{margin:0;font-size:22px}.setup-cta p{margin:0;color:#667085;line-height:1.6}
.video-modal{position:fixed;inset:0;z-index:10000;display:none;align-items:center;justify-content:center;padding:24px;background:rgba(5,5,5,.78)}.video-modal.active{display:flex}.video-dialog{position:relative;width:min(920px,100%);background:#050505;border-radius:14px;box-shadow:0 28px 80px rgba(0,0,0,.45);overflow:hidden}.video-frame{width:100%;aspect-ratio:16/9;border:0;display:block;background:#050505}.video-close{position:absolute;right:12px;top:12px;width:38px;height:38px;border:0;border-radius:999px;background:rgba(255,255,255,.92);color:#111;font-size:22px;font-weight:900;cursor:pointer}.product-row{max-width:1180px;margin:auto;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.mini-card{border:1px solid var(--line);border-radius:8px;background:#fff;padding:16px;box-shadow:0 18px 44px rgba(13,13,13,.06);display:grid;gap:12px}.mini-card img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:8px;background:#111}.mini-card h3{font-size:18px;line-height:1.16;margin:0}.mini-card p{font-size:13px;color:#666;line-height:1.45;margin:0;min-height:38px}.mini-card .mini-price{font-size:22px;font-weight:900}.empty-state{max-width:860px;margin:0 auto;border:1px dashed #e0bd72;background:#fff8ea;border-radius:8px;padding:30px;text-align:center;color:#775000;font-weight:800}
.reb-clean-footer{background:linear-gradient(135deg,#050505 0%,#0a0a0a 58%,#1d1506 100%);color:#fff;border-top:1px solid rgba(245,176,38,.2);padding:58px 6vw 24px}.reb-clean-footer-inner{max-width:1480px;margin:0 auto}.reb-clean-footer .reb-clean-footer-grid{display:grid;grid-template-columns:minmax(310px,1.45fr) minmax(135px,.64fr) minmax(155px,.72fr) minmax(230px,.9fr) minmax(230px,.95fr);gap:34px;align-items:start}.reb-clean-footer-logo{width:245px;max-width:74vw;height:auto;display:block;margin-bottom:16px}.reb-clean-footer p{color:rgba(255,255,255,.7);line-height:1.65;margin:0;font-size:15px}.reb-clean-footer h3{color:#f5b026;font-size:13px;font-weight:900;text-transform:uppercase;letter-spacing:.06em;margin:0}.reb-clean-footer-links{display:grid;gap:11px;margin-top:15px}.reb-clean-footer-links a{color:rgba(255,255,255,.82);font-weight:700}.reb-contact-list{display:grid;gap:10px;margin-top:15px}.reb-contact-row{display:grid;grid-template-columns:34px minmax(0,1fr);gap:10px;align-items:center;color:rgba(255,255,255,.82)!important;font-weight:700;line-height:1.35}.reb-contact-row i{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px}.reb-contact-row.phone i{background:#f5b026;color:#050505}.reb-contact-row.email i{background:#6b7280}.reb-contact-row.telegram i{background:#229ed9}.reb-follow-social{display:grid;grid-template-columns:repeat(4,44px);gap:10px;margin-top:15px}.reb-follow-social a{width:44px;height:44px;border-radius:10px;color:#fff!important;display:flex;align-items:center;justify-content:center;font-size:18px}.reb-follow-social .facebook{background:#1877f2}.reb-follow-social .youtube{background:#ff0000}.reb-follow-social .telegram{background:#229ed9}.reb-follow-social .tiktok{background:linear-gradient(135deg,#050505,#101010 56%,#25f4ee);border:1px solid rgba(255,255,255,.24)}.reb-tiktok-svg{width:21px;height:21px;filter:drop-shadow(1px 1px 0 #fe2c55)}.reb-clean-footer-bottom{margin-top:38px;padding-top:18px;border-top:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.6);font-size:14px}.reb-floating-chat{position:fixed;right:26px;bottom:96px;z-index:9999;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:54px;padding:0 18px;border-radius:999px;background:#229ed9;color:#fff!important;font-weight:900;box-shadow:0 18px 42px rgba(34,158,217,.36);border:1px solid rgba(255,255,255,.28);animation:rebFloatChat 3.2s ease-in-out infinite}.reb-floating-chat i{font-size:20px}@keyframes rebFloatChat{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@media(max-width:1180px){.reb-header{align-items:flex-start;flex-direction:column}.reb-nav{width:100%;justify-content:flex-start;overflow-x:auto;overflow-y:hidden;scrollbar-width:none}.reb-nav::-webkit-scrollbar{display:none}.reb-nav a{flex:0 0 auto}}
@media(max-width:1080px){.detail-product-shell,.detail-layout{grid-template-columns:1fr}.price-panel{position:relative;top:auto}.product-row{grid-template-columns:repeat(2,minmax(0,1fr))}.reb-clean-footer .reb-clean-footer-grid{grid-template-columns:1fr 1fr}.reb-clean-footer-brand{grid-column:1/-1}}
.price-panel{padding:26px;background:linear-gradient(180deg,#fff 0%,#fbfcff 100%);border-color:#d9e2ef;box-shadow:0 22px 55px rgba(15,23,42,.1)}.price-panel .badge{margin-bottom:4px}.pricing-title{margin-top:18px}.pricing-title[data-selected]:after{content:attr(data-selected)}.price-options{gap:10px;margin-bottom:14px}.price-option{appearance:none;width:100%;font:inherit;text-align:left;cursor:pointer;padding:13px 14px;border-radius:12px}.price-option.selected{border-color:#f5b026;background:linear-gradient(135deg,#fff8ea 0%,#fff 58%);box-shadow:0 14px 30px rgba(245,176,38,.14)}.price-option:focus-visible{outline:3px solid rgba(37,99,235,.25);outline-offset:2px}.price-option b{font-size:24px}.price-option small{font-size:11px}.price-note{margin:0 0 14px;padding:11px 12px;border:1px solid #e7edf5;border-radius:10px;background:#f8fafc}.detail-rating{margin:0 0 14px;padding:10px 12px;border:1px solid #eef2f6;border-radius:10px;background:#fff;font-size:14px}.benefit-list{gap:8px;margin:0 0 16px;padding:12px;border:1px solid #e7edf5;border-radius:12px;background:#f8fafc}.benefit-list li{grid-template-columns:22px minmax(0,1fr);gap:9px;font-size:14px;line-height:1.38}.benefit-check{width:20px;height:20px;font-size:12px}.detail-actions{margin-top:11px}.detail-actions .reb-btn{min-height:52px;border-radius:10px}.detail-actions.two{gap:10px}.detail-actions.two .reb-btn{min-height:48px;padding:0 12px;font-size:14px}.youtube-play-btn{background:#fff!important}.download-locked,.download-ready{min-height:54px!important;border-radius:10px!important;font-size:15px}.detail-meta{gap:10px;margin-top:16px}.detail-meta div{padding:12px;border-radius:10px;background:#fff9ed}.detail-meta b{font-size:16px}.detail-meta span{font-size:11px}.payment-plan-head{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin:18px 0 14px}.payment-plan-head span{display:block;color:#8a5d00;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.04em}.payment-plan-head h3{margin:4px 0 0;font-size:22px;line-height:1.12}.selected-plan-pill{border:1px solid #f3d393;background:#fff8ea;color:#a36f00;border-radius:999px;padding:7px 11px;font-size:11px;font-weight:900;text-transform:uppercase;white-space:nowrap}.payment-plan-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:0 0 14px}.pay-plan-card{min-height:154px;display:flex!important;flex-direction:column;align-items:flex-start!important;justify-content:space-between!important;text-align:left;border:1px solid #dfe6ef;border-radius:14px;background:linear-gradient(180deg,#fff,#fbfcff);padding:15px!important;cursor:pointer;position:relative;overflow:visible}.pay-plan-card.featured:after{content:"Best Value";position:absolute;right:12px;top:-10px;background:#101312;color:#fff;border-radius:999px;padding:4px 8px;font-size:10px;font-weight:900;text-transform:uppercase}.pay-plan-card.selected{border-color:#f5b026;background:linear-gradient(135deg,#fff8ea 0%,#fff 62%);box-shadow:0 14px 30px rgba(245,176,38,.16)}.pay-plan-card .plan-name{color:#101828;font-size:13px;font-weight:900;text-transform:uppercase}.pay-plan-card .plan-desc{display:block;margin-top:6px;color:#667085;font-size:11px;line-height:1.35;text-transform:none}.pay-plan-card .plan-price{color:#101828;font-size:25px;font-weight:900;line-height:1}.pay-plan-card .plan-type{display:inline-flex;align-items:center;justify-content:center;width:100%;min-height:34px;border-radius:9px;background:#eff6ff;color:#1d4ed8;padding:6px 10px;font-size:10px;font-weight:900;text-transform:uppercase}.pay-plan-card[data-pay-kind="subscription"] .plan-type{background:#111827;color:#fff}.pay-plan-card[data-pay-kind="one_time"] .plan-type{background:#f5b026;color:#070707}.pay-plan-card:hover .plan-type{filter:brightness(.96)}.paypal-inline-note{margin-top:10px;border:1px solid #dbeafe;background:#eff6ff;color:#1e3a8a;border-radius:10px;padding:10px 12px;font-size:12px;line-height:1.45}.paypal-inline-note b{color:#111827}@media(max-width:767px){.payment-plan-grid{grid-template-columns:1fr}.pay-plan-card{min-height:auto;gap:12px}.payment-cta{grid-template-columns:1fr}}
@media(max-width:767px){.reb-top{display:none}.reb-header{position:relative;top:auto;display:grid;grid-template-columns:1fr;padding:18px;gap:18px}.reb-logo img{width:min(245px,72vw)}.reb-nav{flex-wrap:nowrap;overflow-x:auto;background:#101312;border:1px solid rgba(245,176,38,.24);border-radius:12px;padding:8px}.reb-nav a{flex:0 0 auto;min-width:112px;min-height:46px;border:0;color:#fff;display:flex;align-items:center;justify-content:center;padding:0 14px}.reb-nav a.active,.reb-nav a:hover{background:var(--gold);color:#070707}.detail-hero,.detail-section{padding-left:18px;padding-right:18px}.detail-hero{padding-top:30px;padding-bottom:42px}.detail-media-card img{aspect-ratio:1/1}.detail-media-badge{left:14px;top:14px;font-size:11px;padding:8px 11px}.detail-media-caption{position:static;background:#101312;padding:18px}.detail-media-caption h1{font-size:30px}.detail-media-caption p{font-size:15px}.price-panel{padding:22px}.price-option{grid-template-columns:1fr}.price-option b{font-size:24px}.detail-price strong{font-size:38px}.detail-actions.two{grid-template-columns:1fr}.detail-meta{grid-template-columns:1fr}.detail-tabs{gap:18px}.section-head{align-items:flex-start;flex-direction:column}.section-head h2{font-size:30px}.info-card,.spec-card,.broker-reco,.setup-cta{padding:22px}.broker-reco-stats{grid-template-columns:1fr}.product-row{grid-template-columns:1fr}.reb-clean-footer{padding:38px 18px 22px}.reb-clean-footer .reb-clean-footer-grid{grid-template-columns:1fr;gap:26px}.reb-floating-chat{right:14px;bottom:84px;min-height:50px;padding:0 14px;font-size:13px}}
/* Keep the EA hero clean: the full description is available in Overview. */
.detail-media-caption > p { display: none !important; }
</style>
<style id="reb-inline-svg-icons">
.reb-inline-icon::before{content:none!important}.reb-inline-icon svg{width:1em;height:1em;display:block;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.reb-card i.reb-icon svg{width:1.05em;height:1.05em}.reb-follow-social .reb-inline-icon{display:flex;align-items:center;justify-content:center}.reb-follow-social .reb-inline-icon svg{width:1em;height:1em}.reb-contact-row .reb-inline-icon svg{width:15px;height:15px}.reb-clean-footer-btn .reb-inline-icon{display:inline-flex}.reb-floating-chat .reb-inline-icon{display:inline-flex}
</style>
<style id="reb-market-header-standard">
.reb-top{min-height:58px;padding:0 32px;background:#101312;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:22px}
.reb-top .reb-phone{display:flex;align-items:center;gap:10px;color:#fff;font-size:18px;font-weight:800;white-space:nowrap}.reb-top .reb-phone i{color:#f5b026;margin:0}
.reb-top .reb-actions{display:flex;align-items:center;gap:10px}.reb-top .reb-actions a{min-width:106px;min-height:40px;padding:0 20px;border:1px solid rgba(255,255,255,.48);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff!important;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap}
.reb-top .reb-actions a:first-child{background:#f5b026;border-color:#f5b026;color:#050505!important}.reb-top .reb-actions a:hover{filter:brightness(1.04)}
.reb-market-header{position:sticky;top:0;z-index:1000;width:100%;background:#fff;border-bottom:1px solid #e9e4da;box-shadow:0 8px 26px rgba(10,10,10,.06)}
.reb-market-header-inner{width:min(1360px,calc(100% - 64px));min-height:104px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:36px}
.reb-market-brand{display:flex;align-items:center;flex:0 0 auto}.reb-market-brand img{display:block;width:225px;max-width:38vw;height:auto}
.reb-market-nav{display:flex;align-items:center;justify-content:flex-end;gap:3px;margin-left:auto;padding:5px;background:#101312;border:1px solid rgba(245,176,38,.32);border-radius:13px;box-shadow:0 9px 22px rgba(10,10,10,.12)}
.reb-market-nav a{display:flex;align-items:center;justify-content:center;min-height:44px;padding:0 18px;border:0;border-radius:9px;color:#fff!important;font-size:14px;font-weight:800;line-height:1;white-space:nowrap;text-decoration:none;transition:background .18s ease,color .18s ease,transform .18s ease}
.reb-market-nav a:hover{background:rgba(255,255,255,.09);transform:translateY(-1px)}
.reb-market-nav a.active{background:#f5b026;color:#050505!important;box-shadow:0 5px 14px rgba(245,176,38,.28)}
.reb-market-menu-toggle{display:none;width:48px;height:44px;padding:0;border:1px solid #e2d4b8;border-radius:10px;background:#fff8ea;align-items:center;justify-content:center;flex-direction:column;gap:5px;cursor:pointer}
.reb-market-menu-toggle span{display:block;width:22px;height:2px;border-radius:2px;background:#101312;transition:transform .18s ease,opacity .18s ease}
@media(max-width:1160px){.reb-market-header-inner{width:min(100% - 36px,1360px);min-height:90px;gap:20px}.reb-market-brand img{width:195px}.reb-market-nav a{padding:0 11px;font-size:13px}}
@media(max-width:860px){.reb-market-header{position:relative}.reb-market-header-inner{width:100%;min-height:0;padding:15px 18px;display:grid;grid-template-columns:1fr auto;gap:14px}.reb-market-brand img{width:205px;max-width:66vw}.reb-market-menu-toggle{display:flex}.reb-market-nav{grid-column:1/-1;display:none;width:100%;margin:0;padding:8px;background:#101312;border:1px solid rgba(245,176,38,.3);border-radius:12px;box-shadow:0 14px 30px rgba(0,0,0,.16);grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.reb-market-nav.is-open{display:grid}.reb-market-nav a{width:100%;min-height:46px;padding:0 10px;color:#fff!important;font-size:14px}.reb-market-nav a:hover{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.12);transform:none}.reb-market-nav a.active{color:#050505!important}}
@media(max-width:430px){.reb-market-header-inner{padding:13px 14px}.reb-market-brand img{width:185px}.reb-market-nav{grid-template-columns:1fr}.reb-market-nav a{min-height:44px}}
@media(max-width:560px){.reb-top{padding:10px 14px;display:grid;justify-content:stretch;gap:9px}.reb-top .reb-phone{justify-content:center;font-size:16px}.reb-top .reb-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.reb-top .reb-actions a{min-width:0;min-height:38px;padding:0 10px;font-size:13px}}
</style>
<style id="reb-detail-meta-support-polish">
.detail-meta div{text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:78px}.detail-meta span,.detail-meta b{width:100%;text-align:center}.detail-actions.two .support-btn{grid-column:1/-1;display:flex;align-items:center;justify-content:center;gap:9px;width:min(100%,220px)!important;margin-left:auto!important;margin-right:auto!important;background:#f5b026!important;border:1px solid #e3a01b!important;color:#070707!important;font-weight:900;box-shadow:0 12px 26px rgba(245,176,38,.22)}.detail-actions.two .support-btn:hover{background:#e9a51d!important;transform:translateY(-1px)}.support-btn .reb-inline-icon{width:20px;height:20px;display:inline-flex}.support-btn .reb-inline-icon svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}@media(max-width:767px){.detail-meta div{min-height:70px}.detail-actions.two .support-btn{min-height:50px!important;width:min(100%,240px)!important}}
</style>
