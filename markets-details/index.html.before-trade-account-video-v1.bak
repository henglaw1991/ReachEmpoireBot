<script>
(function(){
  var apiBase=(window.REB_API_BASE||'https://admin.reachempirebot.com').replace(/\/$/,'');
  var fallback=[
    {id:'gold-scalper-ea',title:'Gold Scalper EA',category:'Metals',price:'79',description:'XAU/USD scalping EA with clear gold-entry rules, daily loss control, and MT5 setup notes.',youtube_url:'https://www.youtube.com/@ReachEmpireBot',image_url:'/assets/images/resource/reb-robot.png'},
    {id:'forex-trend-rider-ea',title:'Forex Trend Rider EA',category:'Forex',price:'69',description:'Major-pair trend strategy for EUR/USD, GBP/USD, and USD/JPY with session control.',youtube_url:'https://www.youtube.com/@ReachEmpireBot',image_url:'/assets/images/resource/reb-robot.png'},
    {id:'btc-volatility-ea',title:'BTC Volatility EA',category:'Crypto',price:'89',description:'Crypto EA listing for BTC/USD volatility, spread guard, and controlled entries.',youtube_url:'https://www.youtube.com/@ReachEmpireBot',image_url:'/assets/images/resource/reb-robot.png'},
    {id:'session-scalper-ea',title:'Session Scalper EA',category:'Forex',price:'59',description:'London and New York session scalper marketplace listing with news caution notes.',youtube_url:'https://www.youtube.com/@ReachEmpireBot',image_url:'/assets/images/resource/reb-robot.png'}
  ];
  function esc(v){return String(v||'').replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  function money(v){var s=String(v||'').replace(/^\$/,'');return s&&s!=='Review'?'$'+esc(s):'Review';}
  function shortText(v,n){var s=String(v||'').replace(/\s+/g,' ').trim();if(!s)return 'Professional MT5 Expert Advisor package with setup guidance and support.';return s.length>n?s.slice(0,n).replace(/\s+\S*$/,'')+'...':s;}
  function multilineHtml(v){var lines=String(v||'').replace(/\r\n?/g,'\n').split('\n').map(function(line){return line.trim();}).filter(Boolean);if(!lines.length)lines=['Professional MT5 Expert Advisor package with setup guidance and support.'];return '<div class="ea-description-content">'+lines.map(function(line){return '<span class="ea-info-line">'+esc(line)+'</span>';}).join('')+'</div>';}
  function params(){return new URLSearchParams(window.location.search);}
  function youtubeEmbed(url){
    var s=String(url||'');
    var id=(s.match(/[?&]v=([^&]+)/)||s.match(/youtu\.be\/([^?&]+)/)||s.match(/embed\/([^?&]+)/)||[])[1];
    return id?'https://www.youtube.com/embed/'+encodeURIComponent(id)+'?autoplay=1&rel=0':'';
  }
  function isPurchased(item){
    var q=params();
    return item.purchased===true||item.is_purchased===true||item.can_download===true||q.get('purchased')==='1';
  }
  function normalize(item){
    return {id:String(item.id||item.slug||item.title||''),title:item.title||item.name||'EA Bot Listing',category:item.category||item.market||'Forex',price:item.price||item.price_usd||item.lifetime_price||'Review',monthly:item.monthly_price||item.price_monthly||item.monthly||item.monthly_usd||'',annual:item.annual_price||item.price_annual||item.annual||item.yearly_price||item.yearly||'',lifetime:item.lifetime_price||item.price_lifetime||item.lifetime||item.price||item.price_usd||'',description:item.description||item.detail||'Published EA bot from ReachEmpireBot marketplace.',youtube:item.youtube_url||item.youtube||'',image:item.image_url||item.image||'/assets/images/resource/reb-robot.png',download:item.download_url||'',file:item.ea_filename||item.file||'EA file'};
  }
  function load(){
    if(!window.fetch) return Promise.resolve(fallback.map(normalize));
    return fetch(apiBase+'/api/bot-marketplace/listings?v='+Date.now(),{cache:'no-store',mode:'cors'})
      .then(function(r){if(!r.ok)throw new Error('API '+r.status);return r.json();})
      .then(function(data){var raw=Array.isArray(data)?data:(data&&Array.isArray(data.items)?data.items:[]);return raw.length?raw.map(normalize):fallback.map(normalize);})
      .catch(function(){return fallback.map(normalize);});
  }
  function card(item){
    return '<article class="mini-card"><a href="/markets-details/?id='+encodeURIComponent(item.id||item.title)+'"><img src="'+esc(item.image)+'" alt="'+esc(item.title)+'"></a><h3>'+esc(item.title)+'</h3><p>'+esc(item.description).slice(0,96)+'</p><div class="mini-price">'+money(item.price)+'</div><a class="reb-btn light" href="/markets-details/?id='+encodeURIComponent(item.id||item.title)+'">View Details</a></article>';
  }
  function render(items){
    var id=params().get('id')||params().get('title')||'';
    var selected=items.find(function(x){return String(x.id)===id;})||items.find(function(x){return encodeURIComponent(x.title)===id;})||items[0];
    if(!selected){document.getElementById('eaDetailApp').innerHTML='<section class="detail-section"><div class="empty-state">No EA bot listing is available yet.</div></section>';return;}
    document.title=selected.title+' - EA Bot Details';
    var related=items.filter(function(x){return x.id!==selected.id&&String(x.category).toLowerCase()===String(selected.category).toLowerCase();}).slice(0,10);
    if(!related.length) related=items.filter(function(x){return x.id!==selected.id;}).slice(0,10);
    var top=items.slice().sort(function(a,b){return (parseFloat(b.price)||0)-(parseFloat(a.price)||0);}).slice(0,10);
    var embed=youtubeEmbed(selected.youtube);
    var youtube=embed?'<button class="reb-btn light youtube-play-btn" type="button" data-youtube-embed="'+esc(embed)+'"><i class="fab fa-youtube reb-inline-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><rect x="2" y="5" width="20" height="14" rx="4" fill="currentColor" stroke="none"/><path d="m10 9 6 3-6 3Z" fill="#fff" stroke="none"/></svg></i> Play YouTube</button>':'';
    var purchased=isPurchased(selected);
    var download=selected.download&&purchased?'<div class="detail-actions"><a class="reb-btn download-ready" href="'+esc(selected.download)+'" download><i class="fas fa-download reb-inline-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14"/></svg></i> Download EA</a></div>':'<div class="detail-actions"><button class="reb-btn download-locked" type="button" data-download-locked="1"><i class="fas fa-lock reb-inline-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 15v2"/></svg></i> Download EA - Purchase Required</button></div>';
    var disclaimerHtml='<div class="disclaimer-divider"></div><div class="disclaimer-block" id="disclaimer"><h3>Disclaimer &amp; Responsible Trading</h3><p>Trading Forex, CFDs, and other financial instruments involves significant risk. <strong>EA Bots, backtests, historical results, and past performance do not guarantee future profits.</strong></p><p>Always test an EA on a <strong>Demo Account</strong> before using real funds, apply proper risk management, and never trade with money you cannot afford to lose.</p><p>ReachEmpireBot does not provide financial advice or guarantee profits. <strong>Users are fully responsible for their trading decisions, account settings, profits, and losses.</strong></p><p class="final-note"><strong>Trade responsibly. Test before going live. Protect your capital.</strong></p></div>';
    var sidebarHtml='<div class="sidebar-stack"><div class="spec-card"><h3>Product Summary</h3><div class="spec-row"><span>Platform</span><b>MetaTrader 5</b></div><div class="spec-row"><span>Category</span><b>'+esc(selected.category)+'</b></div><div class="spec-row"><span>Delivery</span><b>.ex5 package</b></div><div class="spec-row"><span>Status</span><b>Available</b></div></div><div class="broker-reco"><div class="broker-reco-head"><span class="broker-reco-logo"><img src="/assets/images/resource/reb-robot.png" alt="ReachEmpireBot"></span><div><small>Recommended Broker</small><h3>Trade this EA with a Partner Broker</h3></div></div><p>Choose a ReachEmpireBot partner broker for MT5 account setup, EA usage, and onboarding support.</p><div class="broker-reco-stats"><div><span>Spreads</span><b>Low</b></div><div><span>Platform</span><b>MT5</b></div><div><span>EAs</span><b>Allowed</b></div></div><a class="reb-btn gold" href="/create-trade-account/#brokers">View Partner Brokers</a><div class="broker-risk">Partner links may be referral links. Trading involves risk.</div></div></div>';    document.getElementById('eaDetailApp').innerHTML=
      '<section class="detail-hero"><div class="detail-wrap"><div class="detail-crumb"><a href="/markets/">EA Bot Market</a><span>/</span><span>'+esc(selected.category)+'</span><span>/</span><b>'+esc(selected.title)+'</b></div><div class="detail-product-shell"><div class="detail-left-stack"><div class="detail-media-card"><span class="detail-media-badge">MT5 Expert Advisor</span><img src="'+esc(selected.image)+'" alt="'+esc(selected.title)+'"><div class="detail-media-caption"><h1>'+esc(selected.title)+'</h1><p>'+esc(shortText(selected.description,110))+'</p></div></div><div class="detail-inline-info"><article class="info-card product-copy" id="overview"><h3>EA Strategy Information</h3>'+multilineHtml(selected.description)+disclaimerHtml+'</article></div></div><aside class="price-panel"><span class="badge">'+esc(selected.category)+' EA</span><div class="payment-plan-head"><div><span>Payment Plans</span><h3>Choose Your License</h3></div><b class="selected-plan-pill" data-selected-plan>Lifetime</b></div><div class="price-options payment-plan-grid"><button class="price-option pay-plan-card" type="button" data-plan="Monthly" data-pay-kind="subscription"><span><span class="plan-name">Monthly</span><small class="plan-desc">Flexible month-to-month access and support.</small></span><b class="plan-price">'+money(selected.monthly||selected.price)+'</b><em class="plan-type">Subscribe</em></button><button class="price-option pay-plan-card" type="button" data-plan="Annual" data-pay-kind="subscription"><span><span class="plan-name">Annual</span><small class="plan-desc">Lower long-term cost for active EA users.</small></span><b class="plan-price">'+money(selected.annual||selected.price)+'</b><em class="plan-type">Subscribe</em></button><button class="price-option pay-plan-card featured selected" type="button" data-plan="Lifetime" data-pay-kind="one_time"><span><span class="plan-name">Lifetime</span><small class="plan-desc">One-time payment for package license.</small></span><b class="plan-price">'+money(selected.lifetime||selected.price)+'</b><em class="plan-type">Buy Now</em></button></div><p class="price-note">Select a license plan, then continue with PayPal checkout. Activation and delivery are confirmed after payment.</p><div class="detail-rating"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9734;</span><span>4.8 marketplace rating</span></div><ul class="benefit-list"><li><span class="benefit-check">&#10003;</span><span>Published EA package with image, price, description, and YouTube guide when available.</span></li><li><span class="benefit-check">&#10003;</span><span>Designed for MT5 Expert Advisor installation and setup support.</span></li><li><span class="benefit-check">&#10003;</span><span>Ask ReachEmpireBot support before running automation on a live account.</span></li></ul><div class="paypal-inline-note"><b>Secure payment flow.</b> Review your order on the payment page before PayPal checkout.</div><div class="detail-actions two">'+youtube+'<a class="reb-btn light" href="/contact/">Ask Support</a></div>'+download+'<div class="detail-meta"><div><span>Category</span><b>'+esc(selected.category)+'</b></div><div><span>Platform</span><b>MT5</b></div><div><span>File</span><b>.ex5</b></div></div>'+sidebarHtml+'</aside></div></div></section>'+
      '<section class="detail-section alt top-selling-section"><div class="section-head"><div><span>Top Selling EA</span><h2>Popular Marketplace Picks</h2></div><p>Discover up to 10 popular EA packages from the marketplace.</p></div><div class="product-row top-selling-row" aria-label="Top Selling EA carousel"><div class="top-selling-track"><div class="top-selling-group">'+top.map(card).join('')+'</div><div class="top-selling-group" aria-hidden="true">'+top.map(card).join('')+'</div></div></div></section>'+
      '<section class="detail-section similar-ea-section"><div class="section-head"><div><span>Related EA Strategy</span><h2>Similar EA Bots</h2></div></div><div class="product-row similar-ea-row" aria-label="Similar EA Bots carousel">'+related.map(card).join('')+'</div></section>'+
      '<div class="video-modal" id="eaVideoModal" aria-hidden="true"><div class="video-dialog"><button class="video-close" type="button" aria-label="Close video">&times;</button><iframe class="video-frame" title="EA YouTube video" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe></div></div>';
    Array.prototype.forEach.call(document.querySelectorAll('.detail-meta div'),function(box){var label=box.querySelector('span');var value=box.querySelector('b');if(label&&value&&label.textContent.trim().toLowerCase()==='file')value.textContent='EX5';});
    Array.prototype.forEach.call(document.querySelectorAll('.spec-row'),function(row){var label=row.querySelector('span');var value=row.querySelector('b');if(label&&value&&label.textContent.trim().toLowerCase()==='delivery')value.textContent='EX5 Package';});
    var supportBtn=document.querySelector('.detail-actions.two a[href="/contact/"]');
    if(supportBtn){supportBtn.classList.add('support-btn');supportBtn.innerHTML='<i class="reb-inline-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 13v-2a8 8 0 0 1 16 0v2"/><path d="M4 13a2 2 0 0 0 2 2h1v-6H6a2 2 0 0 0-2 2v2Zm16 0a2 2 0 0 1-2 2h-1V9h1a2 2 0 0 1 2 2v2Z"/><path d="M17 15v1a3 3 0 0 1-3 3h-2"/></svg></i><span>Ask Support</span>';}
    var playBtn=document.querySelector('[data-youtube-embed]');
    var modal=document.getElementById('eaVideoModal');
    var frame=modal?modal.querySelector('iframe'):null;
    var closeBtn=modal?modal.querySelector('.video-close'):null;
    if(playBtn&&modal&&frame){
      playBtn.addEventListener('click',function(){frame.src=this.getAttribute('data-youtube-embed');modal.classList.add('active');modal.setAttribute('aria-hidden','false');});
    }
    if(closeBtn&&modal&&frame){
      closeBtn.addEventListener('click',function(){modal.classList.remove('active');modal.setAttribute('aria-hidden','true');frame.src='';});
      modal.addEventListener('click',function(e){if(e.target===modal)closeBtn.click();});
    }
    var locked=document.querySelector('[data-download-locked]');
    if(locked){
      locked.addEventListener('click',function(){alert('This EA file is available after PayPal payment confirmation. Please complete checkout first or contact support.');});
    }
    function selectedPlanPayload(action){
      var active=document.querySelector('.price-option[data-plan].selected')||document.querySelector('.price-option[data-plan]');
      var plan=active?active.getAttribute('data-plan'):'Lifetime';
      var amount=plan==='Monthly'?(selected.monthly||selected.price):plan==='Annual'?(selected.annual||selected.price):(selected.lifetime||selected.price);
      return {bot_id:selected.id,title:selected.title,category:selected.category,image:selected.image,plan:plan,payment_type:action==='subscribe'?'subscription':'one_time',amount:amount,currency:'USD'};
    }
    function startPayPalCheckout(action,button){
      var payload=selectedPlanPayload(action);
      payload.monthly=selected.monthly||selected.price;
      payload.annual=selected.annual||selected.price;
      payload.lifetime=selected.lifetime||selected.price;
      var qs=new URLSearchParams(payload);
      window.location.href='/payment.html?'+qs.toString();
    }
    document.querySelectorAll('.price-option[data-plan]').forEach(function(btn){
      btn.addEventListener('click',function(){
        document.querySelectorAll('.price-option[data-plan]').forEach(function(x){x.classList.remove('selected');});
        this.classList.add('selected');
        var title=document.querySelector('[data-selected-plan]');
        if(title) title.textContent=this.getAttribute('data-plan');
        startPayPalCheckout(this.getAttribute('data-pay-kind')==='subscription'?'subscribe':'buy',this);
      });
    });
  }
  document.addEventListener('DOMContentLoaded',function(){load().then(render);});
})();
</script>
<script id="reb-market-header-script">
(function(){var button=document.querySelector('.reb-market-menu-toggle');var nav=document.querySelector('.reb-market-nav');if(!button||!nav)return;button.addEventListener('click',function(){var open=nav.classList.toggle('is-open');button.setAttribute('aria-expanded',String(open));button.setAttribute('aria-label',open?'Close navigation menu':'Open navigation menu');});nav.addEventListener('click',function(event){if(event.target.closest('a')){nav.classList.remove('is-open');button.setAttribute('aria-expanded','false');button.setAttribute('aria-label','Open navigation menu');}});})();
</script>
<script src="/assets/js/ea-details-content-v12.js?v=20260725-15"></script>
<script src="/assets/js/reb-unified-drawer-v41.js?v=20260726-drawer47"></script>
</body>
</html>




