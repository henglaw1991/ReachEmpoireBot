ckground .18s ease}.reb-floating-chat i{font-size:20px}.reb-floating-chat:hover{background:#1b8fc6;color:#fff!important;transform:translateY(-3px)}@keyframes rebFloatChat{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}@keyframes rebChatPulse{0%,100%{box-shadow:0 18px 42px rgba(34,158,217,.36),0 0 0 0 rgba(34,158,217,.28)}50%{box-shadow:0 22px 48px rgba(34,158,217,.42),0 0 0 10px rgba(34,158,217,0)}}
