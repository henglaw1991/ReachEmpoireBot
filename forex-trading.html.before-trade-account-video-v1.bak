<style id="reb-vercel-safe-fix">
[class*="lang"], [id*="lang"], .language-dropdown, .language-selector, .language-switcher,
.lang-switcher, .lang-dropdown, .flag-dropdown, .flag-selector{
  display:none!important;visibility:hidden!important;opacity:0!important;width:0!important;height:0!important;overflow:hidden!important;
}
img{max-width:100%}
@media(max-width:900px){
  body{overflow-x:hidden!important}
  .form-grid,.auth-grid{grid-template-columns:1fr!important}
  input,select,button,.btn{max-width:100%!important}
}
</style>

<style id="reb-standard-mobile-menu">
@media(max-width:767px){
  body{overflow-x:hidden!important}
  .reb-top{display:flex!important;justify-content:flex-end!important;align-items:center!important;width:100%!important;padding:12px 18px!important;background:#101312!important;box-sizing:border-box!important}
  .reb-top .reb-phone{display:none!important}
  .reb-top .reb-actions{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important;width:min(280px,calc(100vw - 36px))!important;margin-left:auto!important;margin-right:auto!important}
  .reb-top .reb-actions a{display:flex!important;align-items:center!important;justify-content:center!important;min-width:0!important;min-height:44px!important;padding:0 14px!important;border-radius:9px!important;font-size:15px!important;font-weight:800!important;line-height:1!important;white-space:nowrap!important;text-align:center!important}
  .reb-header{position:relative!important;top:auto!important;display:grid!important;grid-template-columns:1fr!important;width:100%!important;max-width:100%!important;padding:18px!important;gap:18px!important;background:#fff!important;border-bottom:1px solid #ececec!important;box-sizing:border-box!important;overflow:hidden!important}
  .reb-header .reb-logo,.reb-logo{display:flex!important;align-items:center!important;justify-content:flex-start!important;width:100%!important;max-width:100%!important;margin:0!important}
  .reb-header .reb-logo img,.reb-logo img{width:min(245px,72vw)!important;max-width:72vw!important;height:auto!important;display:block!important}
  .reb-nav{display:flex!important;flex-wrap:nowrap!important;align-items:center!important;width:100%!important;max-width:100%!important;min-width:0!important;gap:8px!important;margin:0!important;padding:8px!important;background:#101312!important;border:1px solid rgba(245,176,38,.24)!important;border-radius:12px!important;box-shadow:0 12px 24px rgba(0,0,0,.12)!important;overflow-x:auto!important;overflow-y:hidden!important;scrollbar-width:none!important;box-sizing:border-box!important;-webkit-overflow-scrolling:touch!important} .reb-nav::-webkit-scrollbar{display:none!important}
  .reb-nav a,.reb-nav a.trade-account-link{display:flex!important;align-items:center!important;justify-content:center!important;flex:0 0 auto!important;width:auto!important;min-width:112px!important;min-height:46px!important;padding:0 14px!important;border:0!important;border-radius:9px!important;background:transparent!important;color:#fff!important;font-size:14px!important;font-weight:800!important;line-height:1.08!important;white-space:nowrap!important;text-align:center!important;box-sizing:border-box!important}
  .reb-nav a.active,.reb-nav a:hover{background:var(--gold,#f5b026)!important;color:#070707!important;box-shadow:inset 0 -2px 0 rgba(0,0,0,.18)!important}
}
@media(max-width:380px){
  .reb-top{padding-left:14px!important;padding-right:14px!important}
  .reb-header{padding:16px 14px!important}
  .reb-nav{gap:7px!important;padding:7px!important} .reb-nav a,.reb-nav a.trade-account-link{font-size:13px!important;min-width:104px!important;min-height:44px!important;padding:0 12px!important}
}
</style>
