<script id="reb-market-header-script">
(function(){var button=document.querySelector('.reb-market-menu-toggle');var nav=document.querySelector('.reb-market-nav');if(!button||!nav)return;button.addEventListener('click',function(){var open=nav.classList.toggle('is-open');button.setAttribute('aria-expanded',String(open));button.setAttribute('aria-label',open?'Close navigation menu':'Open navigation menu');});nav.addEventListener('click',function(event){if(event.target.closest('a')){nav.classList.remove('is-open');button.setAttribute('aria-expanded','false');button.setAttribute('aria-label','Open navigation menu');}});})();
</script>
<script id="reb-forex-setup-content-v37">
document.addEventListener('DOMContentLoaded',function(){
  var table=document.querySelector('.reb-panel .reb-table');
  if(!table)return;
  var panel=table.closest('.reb-panel');
  if(panel)panel.classList.add('reb-recommended-setup');
  var content=[
    ['Best for','Major and minor currency-pair trading'],
    ['Main System','EURUSD, GBPUSD and USDJPY'],
    ['Risk Focus','Spread, lot size and exposure control'],
    ['Trading Mode','MT5 Forex automated trading']
  ];
  table.querySelectorAll('tr').forEach(function(row,index){
    var cells=row.querySelectorAll('td');
    if(cells.length>1&&content[index]){
      cells[0].textContent=content[index][0];
      cells[1].textContent=content[index][1];
    }
  });
});
</script>
</body></html>














