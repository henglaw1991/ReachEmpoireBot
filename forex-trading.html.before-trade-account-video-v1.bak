<!DOCTYPE html><html lang="en"><head>
    <base href="/"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Forex Trading - ReachEmpireBot</title><link rel="icon" href="/assets/images/favicon.ico" type="image/x-icon"><link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&display=swap" rel="stylesheet"><link href="/assets/css/font-awesome-all.css" rel="stylesheet"><style>
:root{--gold:#f5b026;--black:#050505;--ink:#111;--muted:#666;--line:#e8e2d6;--soft:#fff8ea;--bg:#fff}
*{box-sizing:border-box}html,body{width:100%;max-width:100%;overflow-x:hidden}body{margin:0;font-family:Ubuntu,Arial,sans-serif;color:var(--ink);background:#fff}a{text-decoration:none;color:inherit}.reb-top{background:#101312;color:#fff;padding:16px 7vw;display:flex;align-items:center;justify-content:space-between;gap:18px}.reb-phone{font-size:20px;font-weight:700}.reb-phone i{color:var(--gold);margin-right:10px}.reb-actions{display:flex;gap:10px}.reb-actions a{border:1px solid rgba(255,255,255,.45);border-radius:8px;padding:10px 22px;font-weight:700}.reb-actions a:first-child{background:var(--gold);border-color:var(--gold);color:#070707}.reb-header{padding:18px 7vw;border-bottom:1px solid #eee;background:#fff;display:flex;align-items:center;justify-content:space-between;gap:26px;position:sticky;top:0;z-index:20}.reb-logo img{width:260px;max-width:52vw;height:auto;display:block}.reb-nav{display:flex;align-items:center;gap:14px;flex-wrap:wrap}.reb-nav a{border:1px solid var(--black);border-radius:999px;padding:8px 22px;font-weight:700}.reb-nav a.active,.reb-nav a:hover{border-color:var(--gold);color:#050505;background:#fff9ed}.reb-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:54px;border-radius:8px;padding:0 28px;font-weight:700}.reb-btn.gold{background:var(--gold);color:#070707}.reb-btn.dark{background:#050505;color:#fff}.reb-hero{background:radial-gradient(circle at 82% 34%,rgba(245,176,38,.28),transparent 30%),linear-gradient(135deg,#050505,#171106 78%);color:#fff;padding:78px 7vw}.reb-hero-inner{max-width:1180px;margin:auto;display:grid;grid-template-columns:1.05fr .95fr;gap:44px;align-items:center}.reb-kicker{color:var(--gold);font-weight:700;text-transform:uppercase;letter-spacing:.04em;margin-bottom:16px}.reb-hero h1{font-size:58px;line-height:1.05;margin:0 0 22px}.reb-hero p{font-size:20px;line-height:1.7;color:rgba(255,255,255,.78);max-width:660px}.reb-hero-actions{display:flex;gap:14px;margin-top:30px;flex-wrap:wrap}.reb-hero-card{background:rgba(255,255,255,.08);border:1px solid rgba(245,176,38,.25);border-radius:8px;padding:26px;backdrop-filter:blur(10px)}.reb-hero-card img{width:230px;display:block;margin:0 auto 16px;filter:drop-shadow(0 26px 34px rgba(0,0,0,.4))}.reb-mini-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.reb-mini{background:rgba(0,0,0,.32);border:1px solid rgba(255,255,255,.12);border-radius:8px;padding:14px}.reb-mini strong{display:block;color:var(--gold);font-size:24px}.reb-mini span{font-size:13px;color:rgba(255,255,255,.72)}.reb-section{padding:76px 7vw;background:#fff}.reb-section.alt{background:#f8f8f8}.reb-section-title{text-align:center;max-width:760px;margin:0 auto 46px}.reb-section-title span{display:inline-block;color:#a36f00;background:#fff8ea;border:1px solid #f4d9a7;border-radius:999px;padding:7px 22px;font-size:12px;font-weight:700;text-transform:uppercase}.reb-section-title h2{font-size:46px;line-height:1.08;margin:20px 0 12px}.reb-section-title p{color:var(--muted);font-size:18px;line-height:1.6}.reb-grid{max-width:1180px;margin:auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.reb-card{border:1px solid var(--line);border-radius:8px;background:#fff;box-shadow:0 22px 54px rgba(13,13,13,.07);padding:30px}.reb-card h3{font-size:28px;margin:0 0 12px}.reb-card p{color:var(--muted);line-height:1.65;margin:0 0 20px}.reb-card i.reb-icon{width:62px;height:62px;display:inline-flex;align-items:center;justify-content:center;border-radius:50%;background:#fff8ea;color:var(--gold);font-size:26px;margin-bottom:22px}.reb-list{list-style:none;margin:0 0 24px;padding:0}.reb-list li{padding:10px 0;border-top:1px solid #f1ede4;color:#303030}.reb-list i{color:var(--gold);margin-right:9px}.reb-plan{max-width:1180px;margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:22px}.reb-panel{background:#fff;border:1px solid #eee;border-radius:8px;padding:32px}.reb-panel h3{font-size:30px;margin:0 0 14px}.reb-table{width:100%;border-collapse:collapse}.reb-table td{padding:14px;border-bottom:1px solid #eee}.reb-table td:first-child{font-weight:700}.reb-footer{background:#050505;color:#fff;padding:38px 7vw;display:flex;justify-content:space-between;gap:20px;align-items:center}.reb-footer img{width:220px}.reb-footer p{color:rgba(255,255,255,.68);margin:0}@media(max-width:900px){.reb-top,.reb-header,.reb-footer{padding-left:20px;padding-right:20px}.reb-top,.reb-header,.reb-footer{align-items:flex-start;flex-direction:column}.reb-actions{width:100%;display:grid;grid-template-columns:1fr}.reb-actions a{text-align:center}.reb-nav{width:100%;gap:8px}.reb-nav a{padding:8px 16px}.reb-hero{padding:56px 20px}.reb-hero-inner,.reb-grid,.reb-plan{grid-template-columns:1fr}.reb-hero h1{font-size:42px}.reb-hero p{font-size:18px}.reb-hero-actions{display:grid;grid-template-columns:1fr}.reb-btn{width:100%;padding-left:18px;padding-right:18px}.reb-mini-grid{grid-template-columns:1fr}.reb-section{padding-left:20px;padding-right:20px}.reb-section-title h2{font-size:34px}}
