<style id="reb-inline-svg-icons">
.reb-inline-icon::before{content:none!important}.reb-inline-icon svg{width:1em;height:1em;display:block;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.reb-card i.reb-icon svg{width:1.05em;height:1.05em}.reb-follow-social .reb-inline-icon{display:flex;align-items:center;justify-content:center}.reb-follow-social .reb-inline-icon svg{width:1em;height:1em}.reb-contact-row .reb-inline-icon svg{width:15px;height:15px}.reb-clean-footer-btn .reb-inline-icon{display:inline-flex}.reb-floating-chat .reb-inline-icon{display:inline-flex}
</style>
<style id="reb-market-header-standard">
.reb-top{min-height:58px;padding:0 32px;background:#101312;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:22px}
.reb-top .reb-phone{display:flex;align-items:center;gap:10px;color:#fff;font-size:18px;font-weight:800;white-space:nowrap}.reb-top .reb-phone i{color:#f5b026;margin:0}
.reb-top .reb-actions{display:flex;align-items:center;gap:10px}.reb-top .reb-actions a{min-width:106px;min-height:40px;padding:0 20px;border:1px solid rgba(255,255,255,.48);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff!important;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap}
.reb-top .reb-actions a:first-child{background:#f5b026;border-color:#f5b026;color:#050505!important}.reb-top .reb-actions a:hover{filter:brightness(1.04)}
.reb-market-header{position:sticky;top:0;z-index:1000;width:100%;background:#fff;border-bottom:1px solid #e9e4da;box-shadow:0 8px 26px rgba(10,10,10,.06)}
.reb-market-header-inner{width:min(1360px,calc(100% - 64px));min-height:104px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:36px}
.reb-market-brand{display:flex;align-items:center;flex:0 0 auto}.reb-market-brand img{display:block;width:225px;max-width:38vw;height:auto}
.reb-market-nav{display:flex;align-items:center;justify-content:flex-end;gap:3px;margin-left:auto;padding:5px;background:#101312;border:1px solid rgba(245,176,38,.32);border-radius:13px;box-shadow:0 9px 22px rgba(10,10,10,.12)}
.reb-market-nav a{display:flex;align-items:center;justify-content:center;min-height:44px;padding:0 18px;border:0;border-radius:9px;color:#fff!important;font-size:14px;font-weight:800;line-height:1;white-space:nowrap;text-decoration:none;transition:background .18s ease,color .18s ease,transform .18s ease}
.reb-market-nav a:hover{background:rgba(255,255,255,.09);transform:translateY(-1px)}
.reb-market-nav a.active{background:#f5b026;color:#050505!important;box-shadow:0 5px 14px rgba(245,176,38,.28)}
.reb-market-menu-toggle{display:none;width:48px;height:44px;padding:0;border:1px solid #e2d4b8;border-radius:10px;background:#fff8ea;align-items:center;justify-content:center;flex-direction:column;gap:5px;cursor:pointer}
.reb-market-menu-toggle span{display:block;width:22px;height:2px;border-radius:2px;background:#101312;transition:transform .18s ease,opacity .18s ease}
@media(max-width:1160px){.reb-market-header-inner{width:min(100% - 36px,1360px);min-height:90px;gap:20px}.reb-market-brand img{width:195px}.reb-market-nav a{padding:0 11px;font-size:13px}}
@media(max-width:860px){.reb-market-header{position:relative}.reb-market-header-inner{width:100%;min-height:0;padding:15px 18px;display:grid;grid-template-columns:1fr auto;gap:14px}.reb-market-brand img{width:205px;max-width:66vw}.reb-market-menu-toggle{display:flex}.reb-market-nav{grid-column:1/-1;display:none;width:100%;margin:0;padding:8px;background:#101312;border:1px solid rgba(245,176,38,.3);border-radius:12px;box-shadow:0 14px 30px rgba(0,0,0,.16);grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.reb-market-nav.is-open{display:grid}.reb-market-nav a{width:100%;min-height:46px;padding:0 10px;color:#fff!important;font-size:14px}.reb-market-nav a:hover{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.12);transform:none}.reb-market-nav a.active{color:#050505!important}}
@media(max-width:430px){.reb-market-header-inner{padding:13px 14px}.reb-market-brand img{width:185px}.reb-market-nav{grid-template-columns:1fr}.reb-market-nav a{min-height:44px}}
@media(max-width:560px){.reb-top{padding:10px 14px;display:grid;justify-content:stretch;gap:9px}.reb-top .reb-phone{justify-content:center;font-size:16px}.reb-top .reb-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.reb-top .reb-actions a{min-width:0;min-height:38px;padding:0 10px;font-size:13px}}
</style>
<style id="reb-standard-hero-robot-style">
html body .reb-hero .reb-standard-hero-frame{width:100%!important;height:390px!important;min-height:390px!important;max-height:none!important;padding:28px!important;display:flex!important;align-items:center!important;justify-content:center!important;position:relative!important;overflow:hidden!important;box-sizing:border-box!important}
html body .reb-hero .reb-standard-hero-frame>.reb-standard-hero-robot{display:block!important;width:300px!important;height:300px!important;min-width:0!important;min-height:0!important;max-width:calc(100% - 44px)!important;max-height:300px!important;object-fit:contain!important;object-position:center center!important;margin:0 auto!important;inset:auto!important;transform:none!important;position:relative!important;z-index:1!important;flex:0 0 auto!important}
html body .reb-hero .reb-standard-hero-frame>.reb-mini-grid{width:100%!important;position:relative!important;z-index:2!important}
html body .reb-hero .reb-standard-hero-frame.reb-standard-hero-stats{flex-direction:column!important;justify-content:space-between!important;gap:14px!important;height:auto!important}
@media(max-width:900px){html body .reb-hero .reb-standard-hero-frame{height:300px!important;min-height:300px!important;max-height:none!important;padding:22px!important}html body .reb-hero .reb-standard-hero-frame>.reb-standard-hero-robot{width:220px!important;height:220px!important;max-width:calc(100% - 36px)!important;max-height:220px!important}html body .reb-hero .reb-standard-hero-frame.reb-standard-hero-stats{height:auto!important;gap:12px!important}}
</style>
