<script id="reb-mobile-footer-runtime-v32">
(function () {
  var screenWidth = window.screen && window.screen.width ? window.screen.width : 9999;
  var innerWidth = window.innerWidth || 9999;
  var clientWidth = document.documentElement.clientWidth || 9999;
  var mobileBrowser = /Android|Mobile/i.test(navigator.userAgent || '');
  if (!mobileBrowser && Math.min(screenWidth, innerWidth, clientWidth) > 767) return;
  var grids = document.querySelectorAll('.reb-clean-footer .reb-clean-footer-grid');
  for (var g = 0; g < grids.length; g++) {
    grids[g].style.setProperty('grid-template-columns', 'minmax(0,1.25fr) minmax(131px,.75fr)', 'important');
  }
  var emails = document.querySelectorAll('.reb-clean-footer .reb-contact-row.email span');
  for (var e = 0; e < emails.length; e++) {
    emails[e].style.setProperty('white-space', 'nowrap', 'important');
    emails[e].style.setProperty('word-break', 'normal', 'important');
    emails[e].style.setProperty('overflow-wrap', 'normal', 'important');
    emails[e].style.setProperty('font-size', '10px', 'important');
  }
  var groups = document.querySelectorAll('.reb-clean-footer .reb-follow-social');
  for (var i = 0; i < groups.length; i++) {
    var group = groups[i];
    group.style.setProperty('display', 'flex', 'important');
    group.style.setProperty('flex-direction', 'row', 'important');
    group.style.setProperty('flex-wrap', 'nowrap', 'important');
    group.style.setProperty('gap', '5px', 'important');
    group.style.setProperty('grid-template-columns', 'none', 'important');
    var buttons = group.querySelectorAll('a');
    for (var j = 0; j < buttons.length; j++) {
      buttons[j].style.setProperty('display', 'inline-flex', 'important');
      buttons[j].style.setProperty('flex', '0 0 29px', 'important');
      buttons[j].style.setProperty('width', '29px', 'important');
      buttons[j].style.setProperty('height', '29px', 'important');
      buttons[j].style.setProperty('min-width', '29px', 'important');
      buttons[j].style.setProperty('min-height', '29px', 'important');
      buttons[j].style.setProperty('max-width', '29px', 'important');
      buttons[j].style.setProperty('max-height', '29px', 'important');
      buttons[j].style.setProperty('font-size', '12px', 'important');
      buttons[j].style.setProperty('border-radius', '8px', 'important');
      buttons[j].style.setProperty('align-items', 'center', 'important');
      buttons[j].style.setProperty('justify-content', 'center', 'important');
    }
  }
})();
</script>
</body>
</html>
















