</head>
<body>
<main class="reb-shell">
  <header class="reb-topbar">
    <a class="reb-brand" href="/" aria-label="ReachEmpireBot Home">
      <img src="/assets/images/logo-2.png" alt="ReachEmpireBot">
    </a>
    <nav class="reb-actions" aria-label="Dashboard actions">
      <a class="reb-btn" href="/"><i class="fas fa-home"></i> Home</a>
      <a class="reb-btn" href="/markets/"><i class="fas fa-store"></i> EA Bot Market</a>
      <a class="reb-btn" href="/sell-ea/"><i class="fas fa-tags"></i> Sell Your EA</a>
      <a class="reb-btn" href="/create-trade-account/"><i class="fas fa-user-plus"></i> Trade Account</a>
      <a class="reb-btn primary" href="/download/"><i class="fas fa-download reb-inline-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14"/></svg></i> Download Bot</a>
      <button class="reb-btn danger" id="logoutBtn" type="button"><i class="fas fa-sign-out-alt"></i> Logout</button>
    </nav>
  </header>

  <section class="reb-hero">
    <div class="reb-card reb-welcome">
      <p class="reb-kicker">Client Dashboard</p>
      <h1>Welcome Back,<br><span id="userName">Trader</span></h1>
      <p class="reb-lead">Monitor your ReachEmpireBot account, bot package, trading connection, and support actions from one clean dashboard after login.</p>
      <div class="reb-status-row">
        <div class="reb-stat"><strong id="licenseType">Loading</strong><span>Account Type</span></div>
        <div class="reb-stat"><strong id="accountKind">MT5</strong><span>Login Account</span></div>
        <div class="reb-stat"><strong id="botState">Checking</strong><span>Bot Status</span></div>
      </div>
    </div>
    <aside class="reb-card reb-profile">
      <span class="reb-pill" id="sessionPill"><i class="fas fa-check-circle"></i> Logged In</span>
      <div class="reb-profile-main">
        <div class="reb-avatar"><i class="fas fa-user"></i></div>
        <div>
          <h2 id="profileName">Trader</h2>
          <p><span id="licenseLine">ReachEmpireBot client session</span><br><span id="loginTime">Login time ready</span></p>
        </div>
      </div>
      <div class="reb-profile-details" aria-label="Client credentials">
        <div class="reb-profile-detail"><span>Username</span><strong id="detailUsername">-</strong></div>
        <div class="reb-profile-detail"><span>Password</span><strong id="detailPassword">-</strong></div>
        <div class="reb-profile-detail"><span>License Key</span><strong id="detailLicenseKey" class="reb-pending-key">Please wait a moment for activation confirmation</strong></div>
      </div>
      <div class="reb-chart" aria-label="Report chart for balance, profit, and loss">
        <div class="reb-chart-title"><strong>Report Snapshot</strong><span>Balance / Profit / Loss</span></div>
        <div class="reb-chart-bars">
          <div class="reb-chart-col">
            <div class="reb-chart-bar-wrap"><div class="reb-chart-bar balance" id="chartBalanceBar"></div></div>
            <span class="reb-chart-label balance">Balance<b id="chartBalanceText">0.00</b></span>
          </div>
          <div class="reb-chart-col">
            <div class="reb-chart-bar-wrap"><div class="reb-chart-bar profit" id="chartProfitBar"></div></div>
            <span class="reb-chart-label profit">Profit<b id="chartProfitText">0.00</b></span>
          </div>
          <div class="reb-chart-col">
            <div class="reb-chart-bar-wrap"><div class="reb-chart-bar loss" id="chartLossBar"></div></div>
            <span class="reb-chart-label loss">Loss<b id="chartLossText">0.00</b></span>
          </div>
        </div>
      </div>
    </aside>
  </section>

  <section class="reb-grid" aria-label="Dashboard summary">
    <article class="reb-card reb-panel">
      <h3><i class="fas fa-robot"></i> Bot Package</h3>
      <ul class="reb-list">
        <li><span>Package</span><span class="reb-value" id="packageName">AI Trading Bot</span></li>
        <li><span>Mode</span><span class="reb-value" id="serverMode">Client Mode</span></li>
        <li><span>Status</span><span class="reb-value reb-good" id="botStatusText">Loading</span></li>
      </ul>
    </article>
    <article class="reb-card reb-panel">
      <h3><i class="fas fa-wallet"></i> Account Summary</h3>
      <ul class="reb-list">
        <li><span>Balance</span><span class="reb-value" id="balanceValue">0.00</span></li>
        <li><span>Equity</span><span class="reb-value" id="equityValue">0.00</span></li>
        <li><span>Floating P/L</span><span class="reb-value reb-warn" id="floatingValue">0.00</span></li>
      </ul>
    </article>
    <article class="reb-card reb-panel">
      <h3><i class="fas fa-chart-line"></i> Report Metrics</h3>
      <ul class="reb-list">
        <li><span>Profit</span><span class="reb-value reb-good" id="profitValue">0.00</span></li>
        <li><span>Loss</span><span class="reb-value reb-bad" id="lossValue">0.00</span></li>
        <li><span>Deposit</span><span class="reb-value" id="depositValue">0.00</span></li>
        <li><span>Withdrawal</span><span class="reb-value" id="withdrawValue">0.00</span></li>
        <li><span>Trades</span><span class="reb-value" id="tradesValue">0</span></li>
      </ul>
    </article>
  </section>
<section class="reb-card reb-report" aria-label="Client report data">
    <div class="reb-report-head">
      <div>
        <h3>Client Account Report</h3>
        <p>Live client data from the server backend after login.</p>
      </div>
      <span class="reb-mini-status" id="apiStatus"><i class="fas fa-sync-alt"></i> Connecting API</span>
    </div>
    <div class="reb-table-wrap">
      <table class="reb-table">
        <thead>
          <tr>
            <th>Login Account</th>
            <th>Symbols</th>
            <th>Account Type</th>
            <th>Broker</th>
            <th>Current Balance</th>
            <th>Deposit</th>
            <th>Withdrawal</th>
            <th>Profit</th>
            <th>Loss</th>
            <th>Trades</th>
          </tr>
        </thead>
        <tbody id="reportBody">
          <tr><td colspan="10">Loading report data...</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="reb-card reb-signal" aria-label="ICT Signal Center">
    <div class="reb-signal-head">
      <div><h3>ICT Signal Center</h3><p>Signals synchronized from Bot Tool and TradingView.</p></div>
      <span class="reb-signal-live" id="signalLiveState">Waiting for signal</span>
    </div>
    <div class="reb-signal-grid">
      <div class="reb-signal-main">
        <div class="reb-signal-side wait" id="signalSide">WAIT</div>
        <div class="reb-signal-symbol" id="signalSymbol">-</div>
        <span class="reb-signal-sub" id="signalSource">ICT FVG/IFVG + MSS</span>
      </div>
      <div class="reb-signal-metric"><span>Entry</span><strong id="signalEntry">-</strong></div>
      <div class="reb-signal-metric"><span>Stop Loss</span><strong id="signalSl">-</strong></div>
      <div class="reb-signal-metric"><span>Take Profit</span><strong id="signalTp">-</strong></div>
    </div>
    <div class="reb-signal-history" id="signalHistory"><div class="reb-signal-row"><span>No signal history yet.</span></div></div>
  </section>

  <section class="reb-quick" aria-label="Quick actions">
    <a href="/download/"><i class="fas fa-download reb-inline-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14"/></svg></i> Download Setup</a>
    <a href="/markets/"><i class="fas fa-store"></i> View EA Market</a>
    <a href="/sell-ea/"><i class="fas fa-tags"></i> Sell Your EA</a>
    <a href="/create-trade-account/"><i class="fas fa-user-plus"></i> Trade Account</a>
    <a href="/contact/"><i class="fas fa-headset reb-inline-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 14v-2a8 8 0 0 1 16 0v2M4 14h3v6H5a2 2 0 0 1-2-2v-2a2 2 0 0 1 1-2Zm16 0h-3v6h2a2 2 0 0 0 2-2v-2a2 2 0 0 0-1-2ZM17 20c-1 1-2.7 1-5 1"/></svg></i> Contact Support</a>
    <a href="/about/"><i class="fas fa-info-circle"></i> About ReachEmpireBot</a>
  </section>

  </main>

<div class="reb-approval-modal" id="approvalModal" role="dialog" aria-modal="true" aria-labelledby="approvalTitle">
  <div class="reb-approval-box">
    <h3 id="approvalTitle">Account Approved</h3>
    <p id="approvalMessage"></p>
    <button type="button" id="approvalClose">OK</button>
  </div>
</div>

<script>
(function(){
  const REAL_BACKEND_API='https://admin.reachempirebot.com';
  const API_PARAM=new URLSearchParams(window.location.search).get('api');
  if(API_PARAM) localStorage.setItem('REB_API_BASE',API_PARAM);
  let SAVED_API=localStorage.getItem('REB_API_BASE')||'';
  if(SAVED_API.replace(/\/$/,'')===window.location.origin.replace(/\/$/,'')) SAVED_API='';
  const API_BASE=(API_PARAM||SAVED_API||window.REB_API_BASE||REAL_BACKEND_API).replace(/\/$/,'');
  let token=localStorage.getItem('REB_CLIENT_TOKEN')||'';
  let stored={};
  let cachedStatus={};
  let pending={};
  try{stored=JSON.parse(localStorage.getItem('REB_CLIENT_USER')||'{}')||{};}catch(e){stored={};}
  try{cachedStatus=JSON.parse(localStorage.getItem('REB_CLIENT_LAST_STATUS')||'{}')||{};}catch(e){cachedStatus={};}
  try{pending=JSON.parse(localStorage.getItem('REB_CLIENT_PENDING_SIGNUP')||'{}')||{};}catch(e){pending={};}

  const fmt=(v)=>Number(v||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});
  const text=(v,f='-')=>{const s=(v===null||v===undefined)?'':String(v).trim();return s||f;};
  const esc=(v)=>text(v).replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const setText=(id,value)=>{const el=document.getElementById(id);if(el)el.textContent=value;};
  const setMetricClass=(id,value)=>{const el=document.getElementById(id);if(!el)return;el.classList.remove('reb-good','reb-bad','reb-warn');const n=Number(value||0);el.classList.add(n>0?'reb-good':(n<0?'reb-bad':'reb-warn'));};
  const isPendingSession=()=> token.startsWith('PENDING-') || (pending && pending.status==='pending');
  const waitText='Please wait a moment for activation confirmation';

  function updateReportChart(balance, profit, loss){
    const values=[Math.abs(Number(balance)||0),Math.abs(Number(profit)||0),Math.abs(Number(loss)||0)];
    const max=Math.max(...values,1);
    const setBar=(id,value)=>{
      const el=document.getElementById(id);
      if(!el)return;
      const raw=Math.abs(Number(value)||0);
      const pct=raw>0?Math.max(12,Math.min(100,(raw/max)*100)):8;
      el.style.height=pct+'%';
    };
    setBar('chartBalanceBar',balance);
    setBar('chartProfitBar',profit);
    setBar('chartLossBar',loss);
    setText('chartBalanceText',fmt(balance));
    setText('chartProfitText',fmt(profit));
    setText('chartLossText',fmt(loss));
  }

  function machineId(){return text(pending.machine_id||localStorage.getItem('REB_MACHINE_ID'),'');}
  function setCredentialDetails(user){
    user=user||{};
    setText('detailUsername',text(user.username||stored.username||stored.profile?.username||pending.username,'-'));
    setText('detailPassword',text(user.password||stored.profile?.password||pending.password,'-'));
    const key=text(user.license_key||stored.profile?.license_key||pending.license_key,'');
    const keyEl=document.getElementById('detailLicenseKey');
    if(keyEl){
      keyEl.textContent=key||waitText;
      keyEl.classList.toggle('reb-pending-key',!key);
    }
  }
  function inferAccountType(status){
    const account=status.account||{};
    const payload=status.runtime_payload||{};
    const combined=[account.account_type,payload.account_type,payload.account_server,account.broker,payload.broker,payload.broker_name,payload.terminal_title].map(x=>String(x||'').toLowerCase()).join(' ');
    if(combined.includes('demo')||combined.includes('trial')||combined.includes('contest')||combined.includes('practice'))return 'Demo';
    if(combined.includes('real')||combined.includes('live'))return 'Real';
    return 'Unknown';
  }

  const initialName=text(stored.name||stored.username||stored.profile?.name||stored.profile?.username||pending.name||pending.username||cachedStatus.user?.name||cachedStatus.user?.username,'Trader');
  setText('userName',initialName);
  setText('profileName',initialName);
  setCredentialDetails(stored.profile||pending||cachedStatus.user||{});
  if(stored.login_at){setText('loginTime','Logged in '+new Date(stored.login_at).toLocaleString());}
  setText('tokenState',token?'Secure session active':'Dashboard preview session');

  function accountKindFromRow(row, fallbackStatus){
    const label=text(row.account_type_label||row.account_type,'');
    if(label) return label;
    const bucket=String(row.account_type_bucket||'').toLowerCase();
    if(bucket==='demo') return 'Demo';
    if(bucket==='real') return 'Real';
    return inferAccountType(fallbackStatus||{});
  }

  function renderRows(rows, status){
    const user=(status&&status.user)||{};
    const licenseType=text(user.license_type,'Pending Activation');
    const data=Array.isArray(rows)?rows:[];
    if(!data.length){
      document.getElementById('reportBody').innerHTML='<tr><td colspan="10">No report data found for this account yet.</td></tr>';
      return;
    }
    document.getElementById('reportBody').innerHTML=data.map((row)=>{
      const accountType=accountKindFromRow(row,status);
      const symbols=text(row.symbol_list_display||row.symbols_display||row.symbols_text||row.symbols,'-');
      const broker=text(row.broker_display||row.broker_name||row.broker,'Unknown Broker');
      const balance=Number(row.balance||row.current_balance||0);
      const deposit=Number(row.total_deposit||row.deposit||0);
      const withdraw=Number(row.total_withdraw||row.withdraw||row.withdrawal||0);
      const profit=Number(row.total_profit||row.profit||0);
      const loss=Number(row.total_loss||row.loss||0);
      const trades=Number(row.total_trades||row.trades||0);
      return `<tr>
        <td><strong>${esc(row.account_login||'Waiting for MT5 sync')}</strong><span class="muted">${esc(row.username||user.username||initialName)}</span></td>
        <td>${esc(symbols)}</td>
        <td><strong>${esc(accountType)}</strong><span class="muted">${esc(licenseType)}</span></td>
        <td>${esc(broker)}</td>
        <td class="metric">${fmt(balance)}</td>
        <td class="metric">${fmt(deposit)}</td>
        <td class="metric">${fmt(withdraw)}</td>
        <td class="profit">${fmt(profit)}</td>
        <td class="loss">${fmt(loss)}</td>
        <td class="metric">${trades}</td>
      </tr>`;
    }).join('');
  }

  function renderStatus(status, sourceLabel, options){
    if(!status) return;
    options=options||{};
    const user=status.user||{};
    const bot=status.bot||{};
    const account=status.account||{};
    const analytics=status.analytics||{};
    const totals=options.totals||{};
    const displayName=text(user.name||user.username||stored.name||stored.username||pending.name||pending.username,'Trader');
    const licenseType=text(user.license_type,'Pending Activation');
    const accountKind=inferAccountType(status);
    const symbols=Array.isArray(account.symbols)?account.symbols.join(', '):text(account.symbols,'-');
    const balance=Number(account.balance||0);
    const equity=Number(account.equity||0);
    const floating=Number(account.floating_pl||0);
    if(options.rows&&options.rows.length){
      totals.profit=options.rows.reduce((sum,row)=>sum+Number(row.total_profit||row.profit||0),0);
      totals.loss=options.rows.reduce((sum,row)=>sum+Number(row.total_loss||row.loss||0),0);
      totals.trades=options.rows.reduce((sum,row)=>sum+Number(row.total_trades||row.trades||0),0);
      totals.deposit=options.rows.reduce((sum,row)=>sum+Number(row.total_deposit||row.deposit||0),0);
      totals.withdraw=options.rows.reduce((sum,row)=>sum+Number(row.total_withdraw||row.withdraw||row.withdrawal||0),0);
    }
    const profit=Number(totals.profit??analytics.profit??0);
    const loss=Number(totals.loss??analytics.loss??0);
    const trades=Number(totals.trades??analytics.trades??0);
    const deposit=Number(totals.deposit??analytics.deposit??0);
    const withdraw=Number(totals.withdraw??analytics.withdraw??analytics.withdrawal??0);
    setText('userName',displayName);
    setText('profileName',displayName);
    setText('licenseType',licenseType);
    setText('accountKind',text(account.account_login||accountKind,'Waiting'));
    setText('botState',text(bot.running_state,'Stopped'));
    setText('licenseLine',`${licenseType} - ${text(user.license_status,'Pending')}${user.days_left!==null&&user.days_left!==undefined?' - '+user.days_left+' days left':''}`);
    setCredentialDetails({username:user.username||stored.username||pending.username,password:user.password||stored.profile?.password||pending.password,license_key:user.license_key||stored.profile?.license_key||pending.license_key});
    setText('packageName',text(bot.strategy_label,'AI Trading Bot'));
    setText('serverMode',bot.server_mode?'Server Mode':text(bot.mode,'Client Mode'));
    setText('botStatusText',text(bot.running_state,'Stopped'));
    setText('balanceValue',fmt(balance));
    setText('equityValue',fmt(equity));
    setText('floatingValue',fmt(floating));
    setMetricClass('floatingValue',floating);
    setText('profitValue',fmt(profit));
    setText('lossValue',fmt(loss));
    setText('depositValue',fmt(deposit));
    setText('withdrawValue',fmt(withdraw));
    setText('tradesValue',String(trades));
    updateReportChart(balance,profit,loss);
    setText('apiStatus',sourceLabel||'Backend Connected');
    if(options.rows){renderRows(options.rows,status);}else{renderRows([{username:user.username||initialName,account_login:account.account_login||'Waiting for MT5 sync',symbol_list_display:symbols,account_type_label:accountKind,broker_display:account.broker||'Unknown Broker',balance,total_deposit:deposit,total_withdraw:withdraw,total_profit:profit,total_loss:loss,total_trades:trades}],status);}
  }

  function pendingStatusFromLocal(){
    const p=pending||{};
    return {
      user:{username:p.username||stored.username,name:p.name||stored.name,license_type:'Pending Activation',license_status:'Pending',license_key:'',password:p.password},
      bot:{running_state:'Waiting Activation',mode:'client',strategy_label:'AI Trading Bot'},
      account:{account_login:'Waiting for Admin approval',broker:'Pending',symbols:[],balance:0,equity:0,floating_pl:0,positions:0},
      analytics:{profit:0,loss:0,trades:0,deposit:0,withdraw:0},
      runtime_payload:{}
    };
  }

  function renderPending(label){
    setText('sessionPill','Pending Activation');
    renderStatus(pendingStatusFromLocal(),label||'Waiting for Admin approval');
  }

  function showApprovalPopup(info){
    const requestId=text(info.request_id||info.signup_request_id||pending.request_id,'new');
    const flag='REB_APPROVAL_POPUP_SHOWN_'+requestId;
    if(localStorage.getItem(flag)) return;
    const message=`Congratulation! Your account has been successfully approved.\nAccount Type: ${text(info.account_type,'7 days trial')}\nPlease contact Admin to upgarde your Account!\n-Username: ${text(info.username,pending.username)}\n-Password: ${text(info.password,pending.password)}\n-License Key: ${text(info.license_key,'')}\nThank you!`;
    setText('approvalMessage',message);
    const modal=document.getElementById('approvalModal');
    if(modal) modal.classList.add('show');
    localStorage.setItem(flag,'1');
  }

  async function apiGet(path){
    const r=await fetch(API_BASE+path,{headers:{'Authorization':'Bearer '+token,'Accept':'application/json'}});
    const data=await r.json().catch(()=>({}));
    if(!r.ok||data.ok===false) throw new Error(data.error||data.message||'API request failed');
    return data;
  }
  async function apiPost(path,body){
    const r=await fetch(API_BASE+path,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body||{})});
    const data=await r.json().catch(()=>({}));
    if(!r.ok||data.ok===false) throw new Error(data.error||data.message||'API request failed');
    return data;
  }

  async function loginApprovedAccount(info){
    const username=text(info.username||pending.username,'');
    const password=text(info.password||pending.password,'');
    if(!username||!password) return false;
    const data=await apiPost('/api/mobile/login',{username,password,device_name:'Website Dashboard',app_version:'web'});
    if(data.token){
      token=data.token;
      localStorage.setItem('REB_CLIENT_TOKEN',data.token);
      const profile={username,password,license_key:info.license_key||data.status?.user?.license_key||'',license_type:info.account_type||data.status?.user?.license_type||'',name:data.status?.user?.name||pending.name||username,login_at:new Date().toISOString()};
      localStorage.setItem('REB_CLIENT_USER',JSON.stringify({username,name:profile.name,profile,login_at:profile.login_at}));
      localStorage.removeItem('REB_CLIENT_PENDING_SIGNUP');
      pending={};
      if(data.status) localStorage.setItem('REB_CLIENT_LAST_STATUS',JSON.stringify(data.status));
      return true;
    }
    return false;
  }

  async function checkSignupStatus(){
    const mid=machineId();
    if(!mid){renderPending('Waiting for signup data');return;}
    try{
      const r=await fetch(API_BASE+'/api/signup-status?machine_id='+encodeURIComponent(mid),{headers:{'Accept':'application/json'}});
      const info=await r.json();
      if(info.status==='approved' && info.license_key){
        const profile={username:info.username||pending.username,password:info.password||pending.password,license_key:info.license_key,license_type:info.account_type,name:info.name||pending.name||info.username,login_at:new Date().toISOString()};
        localStorage.setItem('REB_CLIENT_USER',JSON.stringify({username:profile.username,name:profile.name,profile,login_at:profile.login_at}));
        showApprovalPopup(info);
        try{await loginApprovedAccount(info); await loadBackendData(); return;}catch(e){renderPending('Approved - login sync pending');return;}
      }
      if(info.status==='rejected'){
        setText('apiStatus','Signup rejected: '+text(info.reason,'Please contact Admin'));
        renderPending('Signup rejected');
        return;
      }
      renderPending('Waiting for activation confirmation');
    }catch(e){renderPending('Backend status offline');}
  }

  function renderReport(report, sourceLabel){
    const status=report.status||{};
    const totals=report.totals||{};
    const rows=Array.isArray(report.accounts)?report.accounts:[];
    renderStatus(status,sourceLabel||'Backend Report Connected',{rows:rows,totals:totals});
  }

  function renderSignals(latest,history){
    latest=latest||{};
    const side=text(latest.side||latest.signal,'WAIT').toUpperCase();
    const sideEl=document.getElementById('signalSide');
    if(sideEl){sideEl.textContent=side;sideEl.className='reb-signal-side '+(side.includes('BUY')?'buy':side.includes('SELL')?'sell':'wait');}
    setText('signalSymbol',text(latest.symbol,'-')+' '+text(latest.timeframe||latest.payload?.timeframe,''));
    setText('signalSource',text(latest.source,'ICT FVG/IFVG + MSS')+' Â· '+text(latest.trend||latest.payload?.trend,'WAIT'));
    setText('signalEntry',text(latest.entry,'-'));
    setText('signalSl',text(latest.sl,'-'));
    setText('signalTp',text(latest.tp,'-'));
    setText('signalLiveState',latest.created_at?'Updated '+new Date(latest.created_at).toLocaleString():'Waiting for signal');
    const rows=Array.isArray(history)?history:[];
    document.getElementById('signalHistory').innerHTML=rows.length?rows.slice(0,8).map(s=>`<div class="reb-signal-row"><strong>${esc(s.symbol)}</strong><span>${esc(s.side||s.signal)}</span><span>E ${esc(s.entry)}</span><span>SL ${esc(s.sl)}</span><span>TP ${esc(s.tp)}</span><span>${esc(s.source)}</span></div>`).join(''):'<div class="reb-signal-row"><span>No signal history yet.</span></div>';
  }

  async function loadSignals(){
    if(!token||isPendingSession())return;
    try{
      const [latest,history]=await Promise.all([apiGet('/api/mobile/signals/latest'),apiGet('/api/mobile/signals/history?limit=20')]);
      renderSignals(latest.signal||latest.latest,(history.signals||history.history||[]));
    }catch(e){setText('signalLiveState','Signal API offline');}
  }

  async function loadBackendData(){
    if(isPendingSession()){await checkSignupStatus();return;}
    if(!token){renderStatus(cachedStatus,'Preview: login required');return;}
    try{
      const data=await apiGet('/api/mobile/client/report');
      const status=data.status||{};
      localStorage.setItem('REB_CLIENT_LAST_STATUS',JSON.stringify(status));
      renderReport(data,'Backend Report Connected');
    }catch(err){
      try{
        const data=await apiGet('/api/mobile/me');
        const status=data.status||data;
        localStorage.setItem('REB_CLIENT_LAST_STATUS',JSON.stringify(status));
        renderStatus(status,'Backend Connected');
      }catch(fallbackErr){
        renderStatus(cachedStatus,'Backend offline: cached data');
        if(!cachedStatus.user){document.getElementById('reportBody').innerHTML='<tr><td colspan="10">Cannot connect to Backend API. Please make sure the server is running and login again.</td></tr>';}
      }
    }
  }

  document.getElementById('approvalClose')?.addEventListener('click',function(){document.getElementById('approvalModal')?.classList.remove('show');});
  document.getElementById('logoutBtn').addEventListener('click',function(){
    const done=()=>{localStorage.removeItem('REB_CLIENT_TOKEN');localStorage.removeItem('REB_CLIENT_USER');localStorage.removeItem('REB_CLIENT_LAST_STATUS');localStorage.removeItem('REB_CLIENT_PENDING_SIGNUP');window.location.href='/login/';};
    if(!token||isPendingSession()){done();return;}
    fetch(API_BASE+'/api/mobile/logout',{method:'POST',headers:{'Authorization':'Bearer '+token}}).finally(done);
  });
  loadBackendData();
  loadSignals();
  if(token&&!isPendingSession())setInterval(loadSignals,10000);
  if(isPendingSession()) setInterval(checkSignupStatus,30000);
})();
</script>
<style id="reb-home-clean-footer">
.reb-clean-footer{background:linear-gradient(135deg,#050505 0%,#0a0a0a 58%,#1d1506 100%);color:#fff;border-top:1px solid rgba(245,176,38,.2);padding:58px 6vw 24px}.reb-clean-footer-inner{max-width:1480px;margin:0 auto}.reb-clean-footer .reb-clean-footer-grid{display:grid;grid-template-columns:minmax(310px,1.45fr) minmax(135px,.64fr) minmax(155px,.72fr) minmax(230px,.9fr) minmax(230px,.95fr)!important;gap:34px;align-items:start}.reb-clean-footer-logo{width:245px;max-width:74vw;height:auto;display:block;margin-bottom:16px}.reb-clean-footer p{color:rgba(255,255,255,.7);line-height:1.65;margin:0;font-size:15px}.reb-clean-footer h3{color:#f5b026;font-size:13px;font-weight:900;text-transform:uppercase;letter-spacing:.06em;margin:0}.reb-clean-footer-links{display:grid;gap:11px;margin-top:15px}.reb-clean-footer-links a{color:rgba(255,255,255,.82);font-weight:700;text-decoration:none}.reb-clean-footer-links a:hover{color:#f5b026}.reb-contact-list{display:grid;gap:10px;margin-top:15px}.reb-contact-row{display:grid;grid-template-columns:34px minmax(0,1fr);gap:10px;align-items:center;color:rgba(255,255,255,.82)!important;text-decoration:none;font-weight:700;line-height:1.35}.reb-contact-row:hover{color:#f5b026!important}.reb-contact-row i{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;transition:transform .18s ease,box-shadow .18s ease}.reb-contact-row:hover i{transform:translateY(-2px);box-shadow:0 10px 22px rgba(0,0,0,.25)}.reb-contact-row.phone i{background:#f5b026;color:#050505}.reb-contact-row.email i{background:#6b7280}.reb-contact-row.telegram i{background:#229ed9}.reb-contact-row span{display:block;min-width:0;overflow-wrap:anywhere}.reb-contact-help{margin-top:14px!important;color:rgba(255,255,255,.62)!important;font-size:14px!important;line-height:1.55!important}.reb-follow-social{display:grid;grid-template-columns:repeat(4,44px);gap:10px;margin-top:15px}.reb-follow-social a{width:44px;height:44px;border-radius:10px;color:#fff!important;display:flex;align-items:center;justify-content:center;text-decoration:none;font-size:18px;transition:transform .18s ease,box-shadow .18s ease,filter .18s ease}.reb-follow-social a:hover{transform:translateY(-3px);box-shadow:0 14px 28px rgba(0,0,0,.28);filter:saturate(1.08)}.reb-follow-social .facebook{background:#1877f2}.reb-follow-social .youtube{background:#ff0000}.reb-follow-social .telegram{background:#229ed9}.reb-follow-social .tiktok{background:linear-gradient(135deg,#050505 0%,#101010 56%,#25f4ee 100%);border:1px solid rgba(255,255,255,.24);position:relative;overflow:hidden}.reb-follow-social .tiktok:after{content:"";position:absolute;right:4px;bottom:4px;width:11px;height:11px;border-radius:50%;background:#fe2c55;opacity:.82}.reb-tiktok-svg{width:21px;height:21px;position:relative;z-index:1;filter:drop-shadow(1px 1px 0 #fe2c55)}.reb-clean-footer-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.reb-clean-footer-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:0 16px;border-radius:8px;background:#f5b026;color:#050505!important;font-weight:900;text-decoration:none}.reb-clean-footer-btn.secondary{background:rgba(255,255,255,.08);border:1px solid rgba(245,176,38,.24);color:#fff!important}.reb-clean-footer-bottom{margin-top:38px;padding-top:18px;border-top:1px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:flex-start;gap:26px;color:rgba(255,255,255,.6);font-size:14px}.reb-floating-chat{position:fixed;right:26px;bottom:96px;z-index:9999;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:54px;padding:0 18px;border-radius:999px;background:#229ed9;color:#fff!important;font-weight:900;text-decoration:none;box-shadow:0 18px 42px rgba(34,158,217,.36);border:1px solid rgba(255,255,255,.28);animation:rebFloatChat 3.2s ease-in-out infinite,rebChatPulse 2.4s ease-in-out infinite;transition:transform .18s ease,background .18s ease}.reb-floating-chat i{font-size:20px}.reb-floating-chat:hover{background:#1b8fc6;color:#fff!important;transform:translateY(-3px)}@keyframes rebFloatChat{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}@keyframes rebChatPulse{0%,100%{box-shadow:0 18px 42px rgba(34,158,217,.36),0 0 0 0 rgba(34,158,217,.28)}50%{box-shadow:0 22px 48px rgba(34,158,217,.42),0 0 0 10px rgba(34,158,217,0)}}
@media(max-width:1180px){.reb-clean-footer .reb-clean-footer-grid{grid-template-columns:1.2fr .8fr .8fr!important}.reb-clean-footer-brand{grid-column:1/-1}.reb-clean-follow{grid-column:auto}.reb-follow-social{grid-template-columns:repeat(4,42px)}.reb-follow-social a{width:42px;height:42px}}
@media(max-width:760px){.reb-clean-footer .reb-clean-footer-grid{grid-template-columns:1fr 1fr!important}.reb-clean-footer-brand{grid-column:1/-1}.reb-clean-contact,.reb-clean-follow{grid-column:auto}}
@media(max-width:640px){.reb-clean-footer{padding:38px 18px 22px}.reb-clean-footer .reb-clean-footer-grid{grid-template-columns:1fr!important;gap:26px}.reb-clean-footer-logo{width:220px}.reb-contact-list{gap:9px}.reb-contact-row{grid-template-columns:32px minmax(0,1fr)}.reb-contact-row i{width:32px;height:32px}.reb-follow-social{grid-template-columns:repeat(4,40px);gap:9px}.reb-follow-social a{width:40px;height:40px}.reb-clean-footer-actions{display:grid;grid-template-columns:1fr;gap:10px}.reb-clean-footer-btn{width:100%;min-width:0}.reb-clean-footer-bottom{flex-direction:column;align-items:flex-start;font-size:13px;gap:18px}.reb-floating-chat{right:14px;bottom:84px;min-height:50px;padding:0 14px;font-size:13px}.reb-floating-chat span{max-width:96px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.reb-floating-chat i{font-size:18px}}
</style>
