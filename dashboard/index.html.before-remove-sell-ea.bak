<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ReachEmpireBot | User Dashboard</title>
<link rel="icon" href="/assets/images/favicon.ico">
<link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/font-awesome-all.css">
<style>
:root{
  --gold:#f5ad18;
  --gold-2:#ffc247;
  --ink:#050505;
  --panel:#121212;
  --panel-2:#191919;
  --line:rgba(245,173,24,.22);
  --muted:#b9b9b9;
  --green:#20c866;
  --red:#ff4d64;
  --cyan:#23d6e8;
}
*{box-sizing:border-box}
body{
  margin:0;
  min-height:100vh;
  font-family:Ubuntu, Arial, sans-serif;
  color:#fff;
  background:
    radial-gradient(circle at 78% 4%, rgba(245,173,24,.22), transparent 30%),
    radial-gradient(circle at 20% 80%, rgba(35,214,232,.10), transparent 28%),
    linear-gradient(135deg,#030303 0%,#0a0a0a 54%,#2d2105 100%);
}
a{text-decoration:none;color:inherit}
.reb-shell{max-width:1320px;margin:0 auto;padding:18px 22px}
.reb-topbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  padding:10px 0 18px;
}
.reb-brand{display:flex;align-items:center;gap:14px}
.reb-brand img{width:170px;max-width:42vw;height:auto}
.reb-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}
.reb-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:9px;
  min-height:42px;
  padding:0 18px;
  border-radius:8px;
  border:1px solid rgba(255,255,255,.18);
  background:rgba(255,255,255,.06);
  color:#fff;
  font-weight:700;
  font-family:inherit;
}
.reb-btn.primary{background:var(--gold);border-color:var(--gold);color:#050505}
.reb-btn.danger{background:rgba(255,77,100,.12);border-color:rgba(255,77,100,.42);color:#ffd2d8}
.reb-hero{
  display:grid;
  grid-template-columns:minmax(0,1.02fr) minmax(360px,.98fr);
  gap:18px;
  align-items:stretch;
}
.reb-card{
  border:1px solid var(--line);
  border-radius:8px;
  background:linear-gradient(180deg,rgba(255,255,255,.075),rgba(255,255,255,.035));
  box-shadow:0 26px 70px rgba(0,0,0,.38);
}
.reb-welcome{padding:28px 30px}
.reb-kicker{
  color:var(--gold);
  font-weight:700;
  font-size:13px;
  letter-spacing:1.2px;
  text-transform:uppercase;
  margin:0 0 14px;
}
h1{
  margin:0;
  color:#fff;
  font-size:clamp(34px,4.2vw,58px);
  line-height:1.02;
  letter-spacing:0;
  font-weight:700;
}
h1 span{color:var(--gold)}
.reb-lead{
  max-width:650px;
  margin:14px 0 0;
  color:#d7d7d7;
  font-size:17px;
  line-height:1.55;
}
.reb-status-row{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
  margin-top:22px;
}
.reb-stat{
  padding:15px;
  border-radius:8px;
  background:rgba(0,0,0,.38);
  border:1px solid rgba(255,255,255,.08);
}
.reb-stat strong{display:block;color:var(--gold);font-size:24px;line-height:1;font-weight:700}
.reb-stat span{display:block;margin-top:8px;color:var(--muted);font-weight:700}
.reb-profile{padding:20px;display:flex;flex-direction:column;gap:14px}
.reb-profile-main{display:flex;align-items:center;gap:16px}
.reb-avatar{
  width:66px;
  height:66px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:var(--gold);
  color:#050505;
  font-size:32px;
  box-shadow:0 0 0 8px rgba(245,173,24,.12);
}
.reb-profile h2{margin:0;font-size:24px;letter-spacing:0}
.reb-profile p{margin:7px 0 0;color:var(--muted);line-height:1.5}
.reb-pill{
  display:inline-flex;
  align-items:center;
  gap:7px;
  width:max-content;
  padding:8px 12px;
  border-radius:999px;
  background:rgba(32,200,102,.12);
  color:#89f2b5;
  border:1px solid rgba(32,200,102,.26);
  font-weight:700;
  font-size:13px;
}
.reb-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:14px;
  margin-top:18px;
}
.reb-panel{padding:20px;min-height:164px}
.reb-panel h3{
  display:flex;
  align-items:center;
  gap:10px;
  margin:0 0 16px;
  font-size:20px;
  letter-spacing:0;
}
.reb-panel h3 i{color:var(--gold)}
.reb-list{display:grid;gap:12px;margin:0;padding:0;list-style:none}
.reb-list li{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  color:#ddd;
  padding:10px 0;
  border-top:1px solid rgba(255,255,255,.08);
}
.reb-list li:first-child{border-top:0}
.reb-value{font-weight:700;color:#fff;text-align:right}
.reb-good{color:#89f2b5}
.reb-warn{color:var(--gold-2)}
.reb-bad{color:#ff9aa8}
.reb-chart{
  min-height:158px;
  border-radius:8px;
  border:1px solid rgba(255,255,255,.08);
  background:
    linear-gradient(180deg,rgba(255,255,255,.045),rgba(0,0,0,.26)),
    #080808;
  position:relative;
  overflow:hidden;
  padding:14px 16px 12px;
}
.reb-chart-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}
.reb-chart-title strong{font-size:15px;color:#fff}
.reb-chart-title span{font-size:11px;text-transform:uppercase;color:var(--gold);font-weight:700;letter-spacing:.5px}
.reb-chart-bars{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;align-items:end;height:92px;border-bottom:1px solid rgba(255,255,255,.12)}
.reb-chart-col{display:grid;grid-template-rows:1fr auto;gap:8px;min-width:0;height:100%}
.reb-chart-bar-wrap{display:flex;align-items:end;justify-content:center;height:100%;border-radius:8px 8px 0 0;background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,.015))}
.reb-chart-bar{width:min(44px,68%);height:18%;border-radius:8px 8px 0 0;box-shadow:0 0 20px rgba(0,0,0,.28);transition:height .35s ease}
.reb-chart-bar.balance{background:linear-gradient(180deg,#ffd067,#f5ad18)}
.reb-chart-bar.profit{background:linear-gradient(180deg,#8cf7b3,#20c866)}
.reb-chart-bar.loss{background:linear-gradient(180deg,#ff9aa8,#ff4d64)}
.reb-chart-label{display:grid;gap:2px;text-align:center;font-size:11px;color:var(--muted);font-weight:700}
.reb-chart-label b{font-size:12px;color:#fff;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.reb-chart-label.balance b{color:#ffd067}.reb-chart-label.profit b{color:#89f2b5}.reb-chart-label.loss b{color:#ff9aa8}
.reb-profile-details{
  display:grid;
  gap:10px;
  padding:14px;
  border-radius:8px;
  background:rgba(0,0,0,.32);
  border:1px solid rgba(255,255,255,.08);
}
.reb-profile-detail{
  display:grid;
  grid-template-columns:108px minmax(0,1fr);
  gap:10px;
  align-items:start;
  font-size:14px;
  color:#d9d9d9;
}
.reb-profile-detail span:first-child{color:var(--gold);font-weight:700;text-transform:uppercase;font-size:11px;letter-spacing:.4px}
.reb-profile-detail strong{font-size:14px;line-height:1.35;word-break:break-word;color:#fff}
.reb-profile-detail .reb-pending-key{color:#ffd37a;font-weight:700}
.reb-approval-modal{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(0,0,0,.72)}
.reb-approval-modal.show{display:flex}
.reb-approval-box{width:min(560px,100%);border-radius:10px;border:1px solid var(--line);background:#111;color:#fff;padding:24px;box-shadow:0 28px 90px rgba(0,0,0,.55)}
.reb-approval-box h3{margin:0 0 12px;color:var(--gold);font-size:24px}
.reb-approval-box p{white-space:pre-line;color:#f4f4f4;line-height:1.6;margin:0 0 18px}
.reb-approval-box button{font:inherit;font-weight:700;border:0;border-radius:8px;background:var(--gold);color:#050505;padding:12px 18px;cursor:pointer}
.reb-quick{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:12px;
  margin:18px 0 22px;
}
.reb-quick a{
  min-height:78px;
  padding:15px;
  border-radius:8px;
  background:var(--panel);
  border:1px solid rgba(255,255,255,.08);
  display:flex;
  flex-direction:column;
  gap:12px;
  font-weight:700;
}
.reb-quick a i{font-size:24px;color:var(--gold)}
.reb-report{margin-top:18px;padding:20px;overflow:hidden}
.reb-report-head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:16px;
  flex-wrap:wrap;
  margin-bottom:16px;
}
.reb-report h3{margin:0;font-size:22px;letter-spacing:0}
.reb-report p{margin:7px 0 0;color:var(--muted);line-height:1.45}
.reb-mini-status{
  display:inline-flex;
  align-items:center;
  gap:8px;
  min-height:34px;
  padding:0 12px;
  border-radius:999px;
  background:rgba(245,173,24,.12);
  border:1px solid rgba(245,173,24,.28);
  color:var(--gold-2);
  font-weight:700;
  font-size:13px;
}
.reb-table-wrap{overflow-x:auto}
.reb-table{
  width:100%;
  border-collapse:collapse;
  min-width:980px;
}
.reb-table th{
  padding:13px 12px;
  text-align:left;
  white-space:nowrap;
  color:#d8c28b;
  border-bottom:1px solid rgba(255,255,255,.12);
  font-size:13px;
  text-transform:uppercase;
}
.reb-table td{
  padding:15px 12px;
  color:#fff;
  border-bottom:1px solid rgba(255,255,255,.08);
  vertical-align:top;
}
.reb-table .muted{display:block;color:var(--muted);font-size:12px;margin-top:4px}
.reb-table .profit{color:#89f2b5;font-weight:700}
.reb-table .loss{color:#ff9aa8;font-weight:700}
.reb-table .metric{font-weight:700}
.reb-footer{
  display:flex;
  justify-content:space-between;
  gap:16px;
  color:#9e9e9e;
  padding:10px 0 26px;
  font-size:14px;
}
@media(max-width:980px){
  .reb-hero,.reb-grid{grid-template-columns:1fr}
  .reb-quick{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:620px){
  .reb-shell{padding:14px}
  .reb-topbar{align-items:flex-start;flex-direction:column}
  .reb-actions{justify-content:flex-start}
  .reb-welcome{padding:22px}
  .reb-status-row,.reb-quick{grid-template-columns:1fr}
}
</style>
<link rel="stylesheet" href="/assets/css/reb-mobile-responsive.css?v=20260519-dense-space1">
<link rel="stylesheet" href="/assets/css/reb-font-scale-polish.css?v=20260530-fontscale1">
<link rel="stylesheet" href="/assets/css/reb-global-page-align.css?v=20260531-marketbanner1">
<style id="reb-dashboard-sell-ea-mobile-fix">
@media (max-width: 720px) {
  html, body { max-width: 100%; overflow-x: hidden; }
  .reb-shell { width: 100%; max-width: 100%; padding-left: 14px; padding-right: 14px; overflow-x: hidden; }
  .reb-topbar { display: grid !important; grid-template-columns: 1fr !important; align-items: start !important; gap: 14px !important; }
  .reb-actions { display: grid !important; grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 8px !important; width: 100% !important; max-width: 100% !important; justify-content: stretch !important; overflow: visible !important; }
  .reb-actions .reb-btn { width: 100% !important; min-width: 0 !important; min-height: 42px !important; padding: 0 8px !important; font-size: 12px !important; line-height: 1.15 !important; white-space: normal !important; text-align: center !important; }
  .reb-actions .reb-btn i { flex: 0 0 auto; }
  .reb-grid, .reb-status-row, .reb-quick { grid-template-columns: 1fr !important; }
  .reb-card, .reb-welcome, .reb-profile, .reb-panel { min-width: 0 !important; max-width: 100% !important; overflow: hidden !important; }
  .reb-list li { display: grid !important; grid-template-columns: minmax(0,1fr) !important; gap: 6px !important; }
  .reb-value { justify-self: start !important; text-align: left !important; max-width: 100% !important; overflow-wrap: anywhere !important; }
}
</style>
<style id="reb-dashboard-layout-polish-final">
@media (min-width: 981px){
  .reb-shell{
    max-width: 1180px!important;
    padding-left: 18px!important;
    padding-right: 18px!important;
  }
  .reb-topbar{
    align-items: center!important;
    padding-bottom: 22px!important;
  }
  .reb-hero{
    grid-template-columns: minmax(0,1fr) minmax(0,1fr)!important;
    gap: 26px!important;
    align-items: stretch!important;
    padding: 28px!important;
    border: 1px solid var(--line)!important;
    border-radius: 14px!important;
    background:
      radial-gradient(circle at 70% 10%,rgba(245,173,24,.12),transparent 34%),
      linear-gradient(180deg,rgba(255,255,255,.075),rgba(255,255,255,.035))!important;
    box-shadow: 0 30px 82px rgba(0,0,0,.42)!important;
  }
  .reb-card{
    border-radius: 10px!important;
  }
  .reb-welcome,
  .reb-profile{
    min-height: 0!important;
    border: 0!important;
    background: transparent!important;
    box-shadow: none!important;
  }
  .reb-welcome{
    display: flex!important;
    flex-direction: column!important;
    justify-content: center!important;
    padding: 8px 18px 8px 8px!important;
    border-right: 1px solid rgba(245,173,24,.18)!important;
  }
  .reb-status-row{
    grid-template-columns: repeat(3,minmax(0,1fr))!important;
    gap: 12px!important;
  }
  .reb-stat{
    min-height: 112px!important;
    padding: 16px 18px!important;
    display: flex!important;
    flex-direction: column!important;
    justify-content: center!important;
    overflow: hidden!important;
  }
  .reb-stat strong{
    font-size: clamp(18px,1.55vw,22px)!important;
    line-height: 1.08!important;
    overflow-wrap: normal!important;
    word-break: normal!important;
    hyphens: manual!important;
  }
  .reb-stat span{
    font-size: 14px!important;
    line-height: 1.35!important;
  }
  .reb-profile{
    padding: 8px 8px 8px 18px!important;
  }
  .reb-profile-details{
    margin-top: 2px!important;
  }
  .reb-chart{
    margin-top: auto!important;
  }
  .reb-grid{
    width: 100%!important;
    max-width: 1180px!important;
    margin: 20px auto 0!important;
    display: grid!important;
    grid-template-columns: repeat(3,minmax(0,1fr))!important;
    gap: 20px!important;
    align-items: stretch!important;
    justify-items: stretch!important;
  }
  .reb-grid > .reb-card{
    width: 100%!important;
    max-width: none!important;
    justify-self: stretch!important;
  }
  .reb-panel{
    min-height: 250px!important;
    padding: 22px!important;
    display: flex!important;
    flex-direction: column!important;
    width: 100%!important;
    max-width: none!important;
  }
  .reb-panel h3{
    min-height: 34px!important;
    margin-bottom: 18px!important;
  }
  .reb-list{
    flex: 0 0 auto!important;
    align-content: start!important;
  }
  .reb-list li{
    display: grid!important;
    grid-template-columns: minmax(0,1fr) minmax(96px,auto)!important;
    align-items: center!important;
    min-height: 42px!important;
    padding: 9px 0!important;
  }
  .reb-value{
    justify-self: end!important;
    text-align: right!important;
    overflow-wrap: anywhere!important;
  }
  .reb-report{
    margin-top: 20px!important;
  }
}
@media (min-width: 721px) and (max-width: 980px){
  .reb-shell{max-width: 760px!important;}
  .reb-hero{
    padding: 22px!important;
    border: 1px solid var(--line)!important;
    border-radius: 14px!important;
    background:linear-gradient(180deg,rgba(255,255,255,.075),rgba(255,255,255,.035))!important;
  }
  .reb-welcome,
  .reb-profile{
    border: 0!important;
    background: transparent!important;
    box-shadow: none!important;
  }
  .reb-grid{grid-template-columns: repeat(2,minmax(0,1fr))!important;gap:16px!important;}
  .reb-panel{min-height: 230px!important;}
  .reb-report{margin-top:16px!important;}
}
@media (max-width: 720px){
  html,
  body{
    max-width: 100%!important;
    overflow-x: hidden!important;
  }
  .reb-shell{
    width: 100%!important;
    max-width: 100vw!important;
    padding-left: 14px!important;
    padding-right: 14px!important;
    overflow: hidden!important;
  }
  .reb-shell > *{
    max-width: 100%!important;
  }
  .reb-actions{
    width: 100%!important;
    grid-template-columns: repeat(2,minmax(0,1fr))!important;
    gap: 8px!important;
  }
  .reb-actions .reb-btn{
    width: 100%!important;
    max-width: 100%!important;
    min-width: 0!important;
    padding-left: 6px!important;
    padding-right: 6px!important;
    font-size: 11px!important;
    white-space: normal!important;
    overflow-wrap: anywhere!important;
    line-height: 1.12!important;
  }
  .reb-hero,
  .reb-grid{
    gap: 14px!important;
  }
  .reb-hero{
    display: block!important;
    width: 100%!important;
    max-width: 100%!important;
    padding: 18px!important;
    border: 1px solid var(--line)!important;
    border-radius: 14px!important;
    background:linear-gradient(180deg,rgba(255,255,255,.075),rgba(255,255,255,.035))!important;
    box-shadow:0 22px 60px rgba(0,0,0,.34)!important;
    overflow: visible!important;
  }
  .reb-welcome,
  .reb-profile{
    border: 0!important;
    background: transparent!important;
    box-shadow: none!important;
    padding: 0!important;
    width: 100%!important;
    max-width: 100%!important;
    overflow: visible!important;
  }
  .reb-profile{
    padding-top: 16px!important;
    border-top: 1px solid rgba(245,173,24,.18)!important;
  }
  .reb-lead,
  .reb-profile p,
  .reb-profile-detail strong{
    max-width: 100%!important;
    overflow-wrap: anywhere!important;
    white-space: normal!important;
  }
  .reb-lead{
    display: block!important;
    width: 100%!important;
    max-width: none!important;
    font-size: 14px!important;
    line-height: 1.45!important;
  }
  .reb-welcome h1{
    font-size: 31px!important;
    line-height: 1.04!important;
  }
  .reb-profile-detail{
    grid-template-columns: 86px minmax(0,1fr)!important;
    gap: 8px!important;
  }
  .reb-chart{
    max-width: 100%!important;
    overflow: visible!important;
    padding-left: 12px!important;
    padding-right: 12px!important;
  }
  .reb-chart-title{
    display: grid!important;
    grid-template-columns: 1fr!important;
    gap: 4px!important;
  }
  .reb-chart-bars{
    gap: 8px!important;
    grid-template-columns: repeat(3,minmax(0,1fr))!important;
  }
  .reb-chart-label{
    font-size: 10px!important;
  }
  .reb-welcome,
  .reb-profile,
  .reb-panel,
  .reb-report{
    border-radius: 10px!important;
  }
  .reb-panel{
    min-height: 0!important;
    padding: 18px!important;
  }
  .reb-list li{
    min-height: 0!important;
  }
}
</style>
<style id="reb-dashboard-single-card-final">
.reb-hero{
  box-sizing:border-box!important;
  width:100%!important;
}
@media (min-width:981px){
  .reb-hero{
    display:grid!important;
    grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;
    gap:28px!important;
    padding:30px!important;
    border:1px solid rgba(245,173,24,.24)!important;
    border-radius:16px!important;
    background:
      radial-gradient(circle at 76% 10%,rgba(245,173,24,.14),transparent 36%),
      linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.035))!important;
    box-shadow:0 32px 86px rgba(0,0,0,.42)!important;
  }
  .reb-hero .reb-welcome,
  .reb-hero .reb-profile{
    width:100%!important;
    min-width:0!important;
    border:0!important;
    border-radius:0!important;
    background:transparent!important;
    box-shadow:none!important;
  }
  .reb-hero .reb-welcome{
    padding:10px 26px 10px 4px!important;
    border-right:1px solid rgba(245,173,24,.2)!important;
  }
  .reb-hero .reb-profile{
    padding:10px 4px 10px 2px!important;
  }
}
@media (max-width:980px){
  .reb-shell{
    width:100%!important;
    max-width:100%!important;
    padding-left:14px!important;
    padding-right:14px!important;
    overflow-x:hidden!important;
  }
  .reb-topbar{
    display:grid!important;
    grid-template-columns:1fr!important;
    justify-items:start!important;
    gap:14px!important;
  }
  .reb-actions{
    display:grid!important;
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
    width:100%!important;
    max-width:100%!important;
    justify-content:stretch!important;
  }
  .reb-actions .reb-btn{
    min-width:0!important;
    width:100%!important;
    max-width:100%!important;
    min-height:40px!important;
    padding:0 8px!important;
    font-size:12px!important;
    line-height:1.15!important;
    white-space:normal!important;
    overflow-wrap:anywhere!important;
    text-align:center!important;
  }
  .reb-hero{
    display:flex!important;
    flex-direction:column!important;
    gap:18px!important;
    padding:18px!important;
    border:1px solid rgba(245,173,24,.24)!important;
    border-radius:14px!important;
    background:
      radial-gradient(circle at 85% 5%,rgba(245,173,24,.13),transparent 40%),
      linear-gradient(180deg,rgba(255,255,255,.075),rgba(255,255,255,.035))!important;
    box-shadow:0 24px 64px rgba(0,0,0,.36)!important;
    overflow:hidden!important;
  }
  .reb-hero .reb-welcome,
  .reb-hero .reb-profile{
    width:100%!important;
    max-width:100%!important;
    min-width:0!important;
    padding:0!important;
    border:0!important;
    border-radius:0!important;
    background:transparent!important;
    box-shadow:none!important;
    overflow:hidden!important;
  }
  .reb-hero .reb-profile{
    padding-top:18px!important;
    border-top:1px solid rgba(245,173,24,.2)!important;
  }
  .reb-welcome h1{
    max-width:100%!important;
    font-size:clamp(30px,9vw,42px)!important;
    line-height:1.05!important;
    overflow-wrap:normal!important;
  }
  .reb-lead{
    width:100%!important;
    max-width:100%!important;
    font-size:14px!important;
    line-height:1.5!important;
    overflow-wrap:break-word!important;
  }
  .reb-status-row{
    grid-template-columns:repeat(3,minmax(0,1fr))!important;
    gap:8px!important;
  }
  .reb-stat{
    min-height:86px!important;
    padding:12px 10px!important;
  }
  .reb-stat strong{
    font-size:clamp(16px,4.8vw,20px)!important;
    line-height:1.06!important;
    overflow-wrap:normal!important;
  }
  .reb-stat span{
    font-size:12px!important;
    line-height:1.25!important;
  }
  .reb-profile-main{
    align-items:flex-start!important;
  }
  .reb-profile-details{
    grid-template-columns:1fr!important;
    gap:8px!important;
  }
  .reb-profile-detail{
    grid-template-columns:92px minmax(0,1fr)!important;
    min-width:0!important;
  }
  .reb-profile-detail strong,
  .reb-profile p{
    min-width:0!important;
    max-width:100%!important;
    overflow-wrap:break-word!important;
    white-space:normal!important;
  }
  .reb-chart{
    width:100%!important;
    max-width:100%!important;
    overflow:hidden!important;
  }
}
@media (max-width:420px){
  .reb-shell{
    padding-left:12px!important;
    padding-right:12px!important;
  }
  .reb-actions{
    grid-template-columns:1fr 1fr!important;
  }
  .reb-hero{
    padding:16px!important;
  }
  .reb-status-row{
    grid-template-columns:1fr!important;
  }
  .reb-stat{
    min-height:72px!important;
  }
  .reb-profile-main{
    display:grid!important;
    grid-template-columns:56px minmax(0,1fr)!important;
    gap:12px!important;
  }
  .reb-avatar{
    width:54px!important;
    height:54px!important;
    font-size:25px!important;
  }
}
</style>
<style id="reb-ict-signal-center">
.reb-signal{margin-top:22px;padding:24px}.reb-signal-head{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:18px}.reb-signal-head h3{margin:0;color:#fff}.reb-signal-live{color:#6df0a4;font-weight:800;font-size:12px}.reb-signal-grid{display:grid;grid-template-columns:1.2fr repeat(3,1fr);gap:12px}.reb-signal-main,.reb-signal-metric{padding:18px;border-radius:16px;background:#0d1523;border:1px solid rgba(255,255,255,.08)}.reb-signal-side{font-size:30px;font-weight:900;letter-spacing:.04em}.reb-signal-side.buy{color:#22b7ff}.reb-signal-side.sell{color:#ff526d}.reb-signal-side.wait{color:#8d98aa}.reb-signal-symbol{color:#fff;font-size:18px;font-weight:800}.reb-signal-sub,.reb-signal-metric span{display:block;color:#8d98aa;font-size:12px;margin-top:5px}.reb-signal-metric strong{display:block;color:#fff;font-size:18px;margin-top:8px;word-break:break-word}.reb-signal-history{display:grid;gap:8px;margin-top:14px}.reb-signal-row{display:grid;grid-template-columns:1fr .6fr .8fr .8fr .8fr 1fr;gap:8px;padding:11px 13px;border-radius:12px;background:rgba(255,255,255,.035);color:#c9d3e4;font-size:12px}.reb-signal-row strong{color:#fff}@media(max-width:760px){.reb-signal-grid{grid-template-columns:1fr 1fr}.reb-signal-main{grid-column:1/-1}.reb-signal-row{grid-template-columns:1fr 1fr 1fr}.reb-signal-row span:nth-child(n+4){display:none}}
</style>
