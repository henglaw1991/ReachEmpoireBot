<!-- V8_ABOUT_VIDEO_FIT_START -->
<style>
@media (min-width: 769px) {
  .v8-about-video-shell {
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    gap: 14px !important;
    padding: 8px 16px 14px !important;
    overflow: hidden !important;
  }

  .v8-about-video {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    max-height: 270px !important;
    aspect-ratio: 16 / 9 !important;
    object-fit: cover !important;
    object-position: center center !important;
    margin: 0 !important;
    border-radius: 14px !important;
  }

  .v8-about-monitor-wrap {
    margin-top: 14px !important;
  }

  .v8-about-monitor {
    margin-top: 0 !important;
  }
}
</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var media = document.querySelector('.about-hero video, .hero video, video');
  if (media) {
    media.classList.add('v8-about-video');
    if (media.parentElement) {
      media.parentElement.classList.add('v8-about-video-shell');
    }
  }

  var nodes = Array.prototype.slice.call(document.querySelectorAll('div, span, p, strong'));
  var monitor = nodes.find(function (element) {
    var text = (element.textContent || '').replace(/\s+/g, ' ').trim();
    return /24\/7/.test(text) && /automation monitoring/i.test(text) && element.children.length < 4;
  });

  if (monitor) {
    monitor.classList.add('v8-about-monitor');
    if (monitor.parentElement) {
      monitor.parentElement.classList.add('v8-about-monitor-wrap');
    }
  }
});
</script>
