                                {"proName": "BINANCE:BTCUSDT", "title": "Crypto BTC/USD"},
                                {"proName": "BINANCE:ETHUSDT", "title": "Crypto ETH/USD"},
                                {"proName": "OANDA:XAUUSD", "title": "Metal XAU/USD"},
                                {"proName": "OANDA:XAGUSD", "title": "Metal XAG/USD"}
                              ],
                              "showSymbolLogo": true,
                              "isTransparent": true,
                              "displayMode": "adaptive",
                              "colorTheme": "dark",
                              "locale": "en"
                            }
