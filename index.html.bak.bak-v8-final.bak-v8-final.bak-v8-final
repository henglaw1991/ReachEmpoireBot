<!-- process-section -->
<section class="process-section reb-process">
    <div class="auto-container">
        <div class="inner-container pt_100 pb_70">
            <div class="sec-title centred pb_60">
                <span class="sub-title mb_14">Setup Flow</span>
                <h2>Launch Automation in Three Steps</h2>
            </div>
            <div class="row clearfix">
                <div class="col-lg-6 col-md-12 col-sm-12 content-column">
                    <div class="content-box">
                        <div class="process-block-one">
                            <div class="inner-box">
                                <div class="shape" style="background-image: url(assets/images/shape/shape-3.png);"></div>
                                <span class="count-text">1</span>
                                <h3>Connect your account</h3>
                                <p>Prepare MT5 access, choose supported symbols, and confirm the account settings the bot should follow.</p>
                            </div>
                        </div>
                        <div class="process-block-one">
                            <div class="inner-box">
                                <div class="shape" style="background-image: url(assets/images/shape/shape-3.png);"></div>
                                <span class="count-text">2</span>
                                <h3>Choose strategy controls</h3>
                                <p>Set lot sizing, trend behavior, rescue mode, and stop conditions before live automation begins.</p>
                            </div>
                        </div>
                        <div class="process-block-one">
                            <div class="inner-box">
                                <div class="shape" style="background-image: url(assets/images/shape/shape-3.png);"></div>
                                <span class="count-text">3</span>
                                <h3>Monitor and adjust</h3>
                                <p>Track live P/L, open trades, signal state, and platform status from the dashboard.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-12 col-sm-12 image-column">
                    <div class="image-box">
                        <figure class="image image-hov-two"><img src="assets/images/resource/reb-robot.png" alt="ReachEmpireBot automation robot"></figure>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- process-section end -->


