<style>
/* Local static preview fixes */
.loader-wrap,.preloader,#handle-preloader,.search-popup{display:none!important;visibility:hidden!important;opacity:0!important;pointer-events:none!important;}
.boxed_wrapper{overflow-x:hidden;}
.main-header .logo-box{
  min-width:276px;
  overflow:visible;
}
.header-style-one .header-lower .logo-box{
  padding:8px 0;
}
.header-style-one .sticky-header .logo-box{
  padding:8px 0;
}
.main-header .logo-box a{
  display:flex;
  align-items:center;
  min-height:82px;
  overflow:visible;
}
.main-header .logo-box img{
  width:260px;
  max-width:260px;
  height:auto;
  max-height:none;
  display:block;
  object-fit:contain;
}
.sticky-header .logo-box img{
  width:220px;
  max-width:220px;
}
.mobile-menu .nav-logo img{
  width:220px;
  max-width:100%;
  height:auto;
  max-height:none;
  object-fit:contain;
}
@media (max-width: 767px){
  .main-header .logo-box{
    min-width:214px;
  }
  .main-header .logo-box a{
    min-height:74px;
  }
  .main-header .logo-box img{
    width:210px;
    max-width:210px;
  }
}
.reb-home{
  --theme-color:#f5b026;
  --theme-color-2:#050505;
  --secondary-color:#050505;
  --title-color:#050505;
}
.reb-home .theme-btn.btn-one,
.reb-home button.theme-btn.btn-one{
  background:#f5b026!important;
  color:#050505!important;
  border:1px solid #f5b026;
  font-weight:700;
}
.reb-home .theme-btn.btn-one:before,
.reb-home .theme-btn.btn-one:after{
  background:#050505!important;
}
.reb-home .theme-btn.btn-one:hover,
.reb-home button.theme-btn.btn-one:hover{
  color:#f5b026!important;
  border-color:#050505;
}
.reb-home .theme-btn.btn-two{
  border-color:#050505;
  color:#050505!important;
}
.reb-home .theme-btn.btn-two:hover{
  color:#fff!important;
}
.reb-home .header-top .theme-btn.btn-two{
  border-color:rgba(255,255,255,.72);
  color:#fff!important;
}
.reb-home .header-top .theme-btn.btn-two:before,
.reb-home .header-top .theme-btn.btn-two:after{
  background:#f5b026!important;
}
.reb-home .header-top .theme-btn.btn-two:hover{
  color:#050505!important;
}
.reb-home .header-bottom .stock-list li span,
.reb-home .header-bottom .stock-list li i{
  color:#f5b026!important;
}
.reb-home .header-bottom .stock-list li strong{
  display:inline-block;
  margin-right:8px;
  padding:2px 8px;
  border-radius:999px;
  background:rgba(245,176,38,.14);
  color:#f5b026;
  font-size:12px;
  line-height:18px;
  text-transform:uppercase;
}
.reb-home .header-bottom .stock-list li em{
  color:rgba(255,255,255,.72);
  font-style:normal;
}
.reb-home .header-bottom .stock-list li:not(.reb-market-tick){
  display:none;
}
.reb-home .header-bottom .reb-live-widget{
  height:46px;
  overflow:hidden;
}
.reb-home .header-bottom .reb-live-widget .tradingview-widget-container,
.reb-home .header-bottom .reb-live-widget .tradingview-widget-container__widget{
  height:46px!important;
}
.reb-home .header-bottom .reb-live-widget + .stock-list{
  display:none;
}
.reb-home.reb-tv-fallback .header-bottom .reb-live-widget{
  display:none;
}
.reb-home.reb-tv-fallback .header-bottom .reb-live-widget + .stock-list{
  display:flex;
}
.reb-home .mobile-nav-toggler{
  background:#050505;
  border-radius:4px;
  padding:10px 12px;
}
.reb-home .mobile-nav-toggler .icon-bar{
  background:#f5b026!important;
}
.reb-home .main-menu .navigation > li.current > a,
.reb-home .main-menu .navigation > li:hover > a{
  border-color:#f5b026!important;
  color:#050505!important;
}
.reb-home .header-top .support-box .icon-box,
.reb-home .search-btn button:hover{
  color:#f5b026!important;
}
.reb-hero-slide{
  background:#030303;
  padding:0!important;
}
.reb-hero{
  position:relative;
  overflow:hidden;
  min-height:640px;
  padding:76px 72px 54px;
  border-radius:10px;
  border:1px solid rgba(245,176,38,.16);
  box-shadow:0 24px 70px rgba(0,0,0,.18);
  background:
    radial-gradient(circle at 82% 44%, rgba(245,176,38,.28) 0, rgba(245,176,38,.10) 28%, rgba(3,3,3,0) 52%),
    radial-gradient(circle at 0 100%, rgba(245,176,38,.22) 0, rgba(245,176,38,.09) 28%, rgba(3,3,3,0) 50%),
    linear-gradient(135deg, #020202 0%, #080808 54%, #11100c 100%);
  color:#fff;
}
.reb-hero,
.reb-hero *{
  box-sizing:border-box;
}

.reb-hero-bg-tv{
  position:absolute;
  inset:0;
  z-index:0;
  opacity:.22;
  pointer-events:none;
  filter:saturate(1.25) contrast(1.18);
}
.reb-hero-bg-tv iframe{
  width:100%;
  height:100%;
  border:0;
  display:block;
  transform:scale(1.08);
  transform-origin:center;
}
.reb-hero-overlay{
  position:absolute;
  inset:0;
  z-index:1;
  pointer-events:none;
  background:
    linear-gradient(90deg, rgba(3,3,3,.96) 0%, rgba(3,3,3,.78) 40%, rgba(3,3,3,.56) 68%, rgba(3,3,3,.72) 100%),
    radial-gradient(circle at 84% 48%, rgba(245,176,38,.25) 0, rgba(245,176,38,.10) 30%, rgba(3,3,3,0) 58%);
}
.reb-market-watch-widget,
.reb-market-watch-widget .tradingview-widget-container,
.reb-market-watch-widget .tradingview-widget-container__widget{
  width:100%!important;
  height:160px!important;
}
.reb-hero:before{
  position:absolute;
  content:'';
  inset:0;
  background-image:
    linear-gradient(rgba(245,176,38,.16) 1px, transparent 1px),
    linear-gradient(90deg, rgba(245,176,38,.16) 1px, transparent 1px);
  background-size:32px 32px;
  opacity:.18;
  mask-image:linear-gradient(90deg, transparent 0%, #000 56%, transparent 100%);
  pointer-events:none;
  z-index:1;
}
.reb-hero:after{
  position:absolute;
  content:'';
  right:8%;
  bottom:-24%;
  width:52%;
  height:52%;
  border-radius:50%;
  border:1px solid rgba(245,176,38,.12);
  background:rgba(245,176,38,.08);
  filter:blur(1px);
  pointer-events:none;
  z-index:1;
}
.reb-hero-inner{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:minmax(0, 1fr) minmax(420px, 520px);
  gap:24px;
  align-items:center;
}
.reb-hero-copy{
  max-width:560px;
}
.reb-hero-kicker{
  display:inline-flex;
  align-items:center;
  gap:10px;
  margin-bottom:22px;
  color:#f5b026;
  font-size:14px;
  line-height:1.2;
  font-weight:700;
  text-transform:uppercase;
}
.reb-hero-kicker:before{
  content:'';
  width:42px;
  height:2px;
  background:#f5b026;
}
.reb-hero h1{
  color:#fff;
  font-size:76px;
  line-height:.96;
  font-weight:700;
  margin-bottom:24px;
}
.reb-hero h1 span{
  color:#f5b026;
  display:block;
  font-weight:400;
}
.reb-hero-text{
  color:rgba(255,255,255,.82);
  font-size:21px;
  line-height:31px;
  max-width:500px;
  margin-bottom:32px;
}
.reb-hero-actions{
  display:flex;
  flex-wrap:wrap;
  gap:14px;
  align-items:center;
  margin-bottom:28px;
}
.reb-hero .reb-secondary-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:56px;
  padding:14px 28px;
  border:1px solid rgba(255,255,255,.22);
  border-radius:4px;
  color:#fff;
  font-weight:700;
}
.reb-hero .reb-secondary-btn:hover{
  border-color:#f5b026;
  color:#f5b026;
}
.reb-hero-stats{
  display:grid;
  grid-template-columns:repeat(3, minmax(0, 1fr));
  gap:12px;
  max-width:520px;
}
.reb-stat{
  border:1px solid rgba(255,255,255,.10);
  border-radius:6px;
  padding:14px 16px;
  background:rgba(255,255,255,.045);
}
.reb-stat strong{
  display:block;
  color:#f5b026;
  font-size:22px;
  line-height:1.1;
  margin-bottom:4px;
}
.reb-stat span{
  display:block;
  color:rgba(255,255,255,.70);
  font-size:13px;
  line-height:18px;
}
.reb-hero-visual{
  position:relative;
  min-height:560px;
}
.reb-robot{
  position:absolute;
  left:-300px;
  bottom:96px;
  z-index:3;
  width:min(430px, 82%);
  filter:drop-shadow(0 30px 34px rgba(0,0,0,.45));
  animation:rebFloat 5s ease-in-out infinite;
}
.reb-feature-list{
  position:absolute;
  right:0;
  top:18px;
  z-index:4;
  display:grid;
  gap:10px;
  width:min(330px, 72%);
}
.reb-feature{
  display:flex;
  align-items:center;
  gap:12px;
  min-height:52px;
  padding:10px 16px 10px 14px;
  border-radius:6px;
  background:linear-gradient(90deg, #ffc755 0%, #f5b026 100%);
  color:#090909;
  font-weight:700;
  box-shadow:0 14px 26px rgba(0,0,0,.25);
  transition:transform 350ms ease, box-shadow 350ms ease;
}
.reb-feature:hover{
  transform:translateX(-6px);
  box-shadow:0 20px 38px rgba(0,0,0,.30);
}
.reb-feature i{
  display:flex;
  align-items:center;
  justify-content:center;
  flex:0 0 28px;
  width:28px;
  height:28px;
  border-radius:50%;
  background:#fff;
  color:#f5a900;
  font-size:14px;
}
.reb-chart-card{
  position:absolute;
  right:6px;
  top:268px;
  bottom:auto;
  z-index:8;
  width:330px;
  min-height:218px;
  padding:14px 14px 12px;
  border:1px solid rgba(245,176,38,.28);
  border-radius:8px;
  background:rgba(5,5,5,.78);
  box-shadow:0 24px 48px rgba(0,0,0,.36);
  backdrop-filter:blur(6px);
}
.reb-chart-card span{
  position:relative;
  z-index:6;
  display:block;
  color:#ffffff;
  font-size:14px;
  font-weight:700;
  letter-spacing:.2px;
  margin-bottom:12px;
  text-shadow:0 2px 8px rgba(0,0,0,.75);
}
.reb-chart-line{
  height:160px;
  border-radius:6px;
  overflow:hidden;
  background:#080808;
}
.reb-chart-line iframe{
  width:100%;
  height:100%;
  border:0;
  display:block;
}
.reb-hero-contact{
  position:absolute;
  left:72px;
  right:72px;
  bottom:32px;
  z-index:4;
  display:flex;
  justify-content:flex-end;
  gap:32px;
  color:#fff;
}
.reb-contact-item{
  display:flex;
  align-items:center;
  gap:12px;
  color:#fff;
}
.reb-contact-item i{
  display:flex;
  align-items:center;
  justify-content:center;
  width:40px;
  height:40px;
  border-radius:50%;
  background:#f5b026;
  color:#050505;
  font-size:17px;
}
.reb-contact-item strong,
.reb-contact-item span{
  display:block;
  color:#fff;
  line-height:19px;
}
.reb-contact-item span{
  color:rgba(255,255,255,.75);
}
@media only screen and (max-width: 1199px){
  .reb-hero{padding:64px 44px 42px;}
  .reb-hero h1{font-size:62px;}
  .reb-hero-inner{grid-template-columns:minmax(0, 1fr) minmax(340px, 430px);}
  .reb-robot{left:-150px;bottom:32px;width:370px;}
  .reb-chart-card{width:285px;top:318px;z-index:5;}
  .reb-hero-contact{left:44px;right:44px;}
}
@media only screen and (max-width: 991px){
  .reb-hero{min-height:0;padding:56px 32px 34px;}
  .reb-hero-inner{grid-template-columns:1fr;gap:34px;}
  .reb-hero-copy{max-width:720px;}
  .reb-hero h1{font-size:56px;}
  .reb-hero-visual{min-height:560px;}
  .reb-feature-list{right:0;top:0;}
  .reb-robot{left:0;bottom:32px;width:min(380px, 76%);}
  .reb-hero-contact{position:relative;left:auto;right:auto;bottom:auto;justify-content:flex-start;margin-top:26px;}
}
@media only screen and (max-width: 767px){
  .banner-section{padding-top:10px!important;}
  .banner-section .large-container{
    max-width:100vw;
    padding-left:15px;
    padding-right:15px;
    overflow:hidden;
  }
  .reb-hero{padding:42px 22px 28px;border-radius:8px;}
  .reb-hero{
    width:100%;
    max-width:100%;
    padding-left:20px;
    padding-right:20px;
  }
  .reb-hero-inner,
  .reb-hero-copy,
  .reb-hero-visual{
    min-width:0;
    width:100%;
  }
  .reb-hero-copy,
  .reb-hero-text{
    max-width:100%;
  }
  .reb-hero-copy{
    width:100%;
  }
  .reb-hero-text{
    max-width:300px;
    overflow-wrap:break-word;
  }
  .reb-hero h1{font-size:43px;line-height:1.02;}
  .reb-hero-text{font-size:16px;line-height:25px;}
  .reb-hero-actions{align-items:stretch;}
  .reb-hero-actions,
  .reb-hero-stats{
    max-width:100%;
  }
  .reb-hero-actions .theme-btn,
  .reb-hero .reb-secondary-btn{
    display:block;
    width:100%;
    max-width:100%;
    padding-left:18px;
    padding-right:18px;
    text-align:center;
  }
  .reb-hero-stats{grid-template-columns:1fr;}
  .reb-hero-visual{min-height:650px;}
  .reb-feature-list{width:100%;position:relative;margin-bottom:22px;}
  .reb-robot{left:50%;bottom:142px;transform:translateX(-50%);width:min(315px, 92%);animation:none;}
  .reb-chart-card{left:0;right:0;top:auto;bottom:0;width:100%;}
  .reb-hero-contact{display:none;}
}
.reb-trust-section{
  position:relative;
  padding:34px 0 46px;
  background:#fff;
}
.reb-trust-panel{
  display:grid;
  grid-template-columns:1.2fr repeat(4, 1fr);
  gap:1px;
  overflow:hidden;
  border-radius:8px;
  background:#dfe4e2;
  border:1px solid #dfe4e2;
}
.reb-trust-lead,
.reb-trust-item{
  background:#f8faf9;
  padding:24px 26px;
  transition:background 300ms ease, transform 300ms ease;
}
.reb-trust-item:hover{
  background:#fff;
  transform:translateY(-2px);
}
.reb-trust-lead span{
  display:block;
  color:#f5a900;
  font-size:13px;
  line-height:18px;
  font-weight:700;
  text-transform:uppercase;
  margin-bottom:5px;
}
.reb-trust-lead strong{
  display:block;
  color:#111;
  font-size:24px;
  line-height:30px;
  font-family:var(--title-font);
}
.reb-trust-item strong{
  display:block;
  color:#111;
  font-size:30px;
  line-height:34px;
  font-family:var(--title-font);
  margin-bottom:6px;
}
.reb-trust-item span{
  display:block;
  color:#666;
  line-height:21px;
}
.reb-home .sec-title .sub-title{
  color:#f5a900;
}
.reb-solutions{
  background:#060606!important;
  border-radius:0!important;
  padding-top:84px!important;
  padding-bottom:54px!important;
}
.reb-solutions .pattern-layer{
  opacity:.12;
}
.reb-solutions .sec-title h2,
.reb-solutions .account-block-one .inner-box h3 a{
  color:#fff;
}
.reb-solutions .account-block-one .inner-box{
  min-height:248px;
  background:linear-gradient(180deg, rgba(255,255,255,.075), rgba(255,255,255,.035));
  border:1px solid rgba(255,255,255,.10);
  box-shadow:none;
}
.reb-solutions .wow,
.reb-solutions .animated{
  visibility:visible!important;
  animation-name:none!important;
}
.reb-solutions .sec-title{
  padding-bottom:34px!important;
}
.reb-solutions .account-block-one .inner-box:hover{
  transform:translateY(-6px);
  border-color:rgba(245,176,38,.44);
  box-shadow:0 20px 50px rgba(0,0,0,.32);
}
.reb-solutions .account-block-one .inner-box p{
  color:rgba(255,255,255,.72);
}
.reb-solutions .account-block-one .inner-box .icon-box{
  background:#f5b026;
  color:#070707;
}
.reb-markets{
  background:#fff;
}
.reb-markets .inner-container{
  border:none;
  display:grid;
  grid-template-columns:repeat(3, minmax(0, 1fr));
  gap:18px;
  overflow:visible;
}
.reb-markets .trading-block-one{
  float:none!important;
  width:auto!important;
}
.reb-markets .trading-block-one .inner-box{
  min-height:360px;
  border:1px solid #e8ecea!important;
  border-radius:8px;
  padding:30px 24px 32px;
  background:#fff;
  box-shadow:0 18px 44px rgba(14,18,18,.06);
}
.reb-markets .trading-block-one .inner-box:hover{
  background:#07100d;
  border-color:#f5b026!important;
  transform:translateY(-6px);
}
.reb-markets .trading-block-one .inner-box h3 a,
.reb-markets .trading-block-one .inner-box p{
  transition:all 350ms ease;
}
.reb-markets .trading-block-one .inner-box h3,
.reb-markets .trading-block-one .inner-box p,
.reb-markets .trading-block-one .inner-box .btn-box{
  position:relative;
  z-index:2;
}
.reb-markets .trading-block-one .inner-box:hover h3 a,
.reb-markets .trading-block-one .inner-box:hover p{
  color:#fff;
}
.reb-markets .trading-block-one .inner-box p{
  opacity:1;
  top:0;
  margin-bottom:88px;
  font-size:16px;
  line-height:25px;
}
.reb-markets .trading-block-one .inner-box .theme-btn{
  opacity:1;
  top:0;
}
.reb-markets .trading-block-one .inner-box .image-box{
  display:none;
}
.reb-markets .trading-block-one .inner-box:hover .image-box{
  filter:none;
  opacity:.22;
}
.reb-platform-section{
  background:#f8faf9;
}
.reb-platform-section .content_block_one .content-box{
  margin-right:40px!important;
}
.reb-platform-section .accordion-box .accordion{
  background:#fff;
  border:1px solid #e6ece9;
  border-radius:8px;
  margin-bottom:14px;
  overflow:hidden;
  box-shadow:0 14px 34px rgba(14,18,18,.05);
}
.reb-platform-section .accordion-box .accordion .acc-btn{
  padding:22px 26px 22px 82px;
}
.reb-platform-section .accordion-box .accordion .acc-btn .icon-box{
  left:24px;
  top:18px;
  background:#f5b026;
  color:#090909;
}
.reb-platform-section .accordion-box .accordion .acc-content .content{
  padding:0 26px 24px 82px;
}
.reb-platform-section .video-box{
  margin-left:20px!important;
}
.reb-platform-section .video-inner{
  min-height:470px;
  border-radius:8px;
  background-size:cover;
  background-position:center;
  box-shadow:0 24px 60px rgba(14,18,18,.16);
}
.reb-platform-section .video-inner:before{
  position:absolute;
  content:'';
  inset:0;
  border-radius:8px;
  background:linear-gradient(180deg, rgba(0,0,0,.05), rgba(0,0,0,.50));
}
.reb-metrics .inner-container{
  background:#07100d;
  border-color:rgba(245,176,38,.22);
}
.reb-metrics .funfact-block-one .inner-box:before{
  background:rgba(245,176,38,.20);
}
.reb-metrics .funfact-block-one .inner-box .count-outer{
  color:#f5b026;
}
.reb-metrics .funfact-block-one .inner-box .count-outer .text{
  color:#fff;
}
.reb-metrics .funfact-block-one .inner-box p{
  color:rgba(255,255,255,.72);
}
.reb-symbol-sync{
  background:#050505;
}
.reb-symbol-sync .project-tab{
  display:none;
}
.reb-symbol-grid{
  display:grid;
  grid-template-columns:repeat(4, minmax(0, 1fr));
  gap:18px;
  text-align:left;
}
.reb-symbol-card{
  position:relative;
  overflow:hidden;
  min-height:210px;
  padding:24px;
  border:1px solid rgba(255,255,255,.10);
  border-radius:8px;
  background:linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.035));
  transition:transform 350ms ease, border-color 350ms ease, background 350ms ease;
}
.reb-symbol-card:before{
  position:absolute;
  content:'';
  right:-46px;
  bottom:-46px;
  width:130px;
  height:130px;
  border-radius:50%;
  background:rgba(245,176,38,.13);
}
.reb-symbol-card span{
  display:inline-flex;
  align-items:center;
  min-height:28px;
  padding:4px 10px;
  border-radius:999px;
  background:rgba(245,176,38,.14);
  color:#f5b026;
  font-size:12px;
  line-height:18px;
  font-weight:700;
  text-transform:uppercase;
  margin-bottom:20px;
}
.reb-symbol-card h3{
  color:#fff;
  font-size:28px;
  line-height:34px;
  margin-bottom:12px;
}
.reb-symbol-card p{
  color:rgba(255,255,255,.72);
  line-height:25px;
  margin-bottom:22px;
}
.reb-symbol-card strong{
  color:#f5b026;
  font-size:18px;
}
.reb-symbol-card:hover{
  transform:translateY(-6px);
  border-color:rgba(245,176,38,.45);
  background:linear-gradient(180deg, rgba(245,176,38,.12), rgba(255,255,255,.035));
}
.reb-symbol-sync .reb-symbol-note{
  display:flex;
  justify-content:space-between;
  gap:18px;
  align-items:center;
  margin-top:28px;
  padding:20px 24px;
  border:1px solid rgba(245,176,38,.18);
  border-radius:8px;
  background:rgba(245,176,38,.08);
  text-align:left;
}
.reb-symbol-note p{
  color:rgba(255,255,255,.78);
  margin:0;
}
.reb-symbol-note a{
  flex:0 0 auto;
}
.reb-process .inner-container{
  border-bottom:none;
}
.reb-process .process-block-one .inner-box{
  background:#fff;
  box-shadow:0 16px 42px rgba(14,18,18,.06);
}
.reb-process .process-block-one .inner-box .count-text{
  background:#f5b026;
  border-color:#f5b026;
  color:#080808;
}
.reb-process .image-box .image{
  min-height:520px;
  background:#050505;
  display:flex;
  align-items:center;
  justify-content:center;
}
.reb-process .image-box .image img{
  width:min(420px, 85%);
  filter:drop-shadow(0 28px 42px rgba(0,0,0,.35));
}
.reb-apps .inner-container{
  background:
    radial-gradient(circle at 82% 48%, rgba(245,176,38,.24), transparent 38%),
    linear-gradient(110deg, #050505 0%, #15110a 100%);
}
.reb-apps .image-layer{
  right:110px;
  bottom:18px;
}
.reb-apps .image-layer img{
  width:260px;
  filter:drop-shadow(0 30px 38px rgba(0,0,0,.35));
}
.reb-news{
  background:#f8faf9;
}
.reb-news .news-block-one .inner-box{
  min-height:320px;
  border:1px solid #e6ece9;
  border-radius:8px;
  background:#fff;
  box-shadow:0 16px 40px rgba(14,18,18,.05);
}
.reb-news .news-block-one .post-date{
  color:#f5a900;
}
.reb-news .news-block-one .author-box{
  display:none;
}
.reb-subscribe{
  background:#fff;
}
.reb-subscribe .bg-color{
  background:#050505;
}
.reb-subscribe .inner-container{
  border-radius:8px;
  background:
    radial-gradient(circle at 92% 22%, rgba(255,255,255,.16), transparent 28%),
    linear-gradient(110deg, #f5b026 0%, #d99812 100%);
  box-shadow:0 24px 56px rgba(5,5,5,.18);
}
.reb-subscribe h2{
  color:#050505;
  font-weight:700;
}
.reb-subscribe .form-inner .form-group input[type='email']{
  border:1px solid rgba(5,5,5,.16);
}
.reb-subscribe .form-inner .form-group button[type='submit']{
  background:#050505!important;
  color:#f5b026!important;
}
.reb-footer{
  background:#050505!important;
  color:#fff;
}
.reb-footer .widget-section{
  border-bottom:1px solid rgba(245,176,38,.16)!important;
}
.reb-footer .widget-title h3,
.reb-footer .footer-card li h4,
.reb-footer .social-links li h5{
  color:#fff;
}
.reb-footer .links-widget .links-list li a,
.reb-footer .footer-bottom .bottom-inner p{
  color:rgba(255,255,255,.72)!important;
}
.reb-footer .links-widget .links-list li a:hover,
.reb-footer .footer-bottom .bottom-inner p a{
  color:#f5b026!important;
}
.reb-footer .logo-widget .widget-content{
  background:rgba(255,255,255,.06);
  border:1px solid rgba(245,176,38,.16);
}
.reb-footer .logo-widget .widget-content p{
  color:rgba(255,255,255,.76);
}
.reb-footer .logo-widget .widget-content .scanner-box{
  background:rgba(255,255,255,.08);
}
.reb-footer .social-links li a{
  background:rgba(255,255,255,.08);
  color:#f5b026;
}
.reb-floating-cta{display:none!important;}
.reb-floating-cta a{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:44px;
  border-radius:999px;
  color:#fff;
  font-weight:700;
}
.reb-floating-cta .reb-call{
  width:44px;
  background:rgba(255,255,255,.10);
  color:#f5b026;
}
.reb-floating-cta .reb-start{
  padding:0 18px;
  background:#f5b026;
  color:#050505;
}
@keyframes rebFloat{
  0%,100%{transform:translateY(0);}
  50%{transform:translateY(-10px);}
}
@media only screen and (max-width: 1199px){
  .reb-trust-panel{grid-template-columns:repeat(2, 1fr);}
  .reb-trust-lead{grid-column:1 / -1;}
  .reb-markets .inner-container{grid-template-columns:repeat(2, minmax(0, 1fr));}
  .reb-symbol-grid{grid-template-columns:repeat(2, minmax(0, 1fr));}
  .reb-apps .image-layer{right:40px;}
}
@media only screen and (max-width: 767px){
  .reb-trust-panel,
  .reb-markets .inner-container{grid-template-columns:1fr;}
  .reb-trust-lead,
  .reb-trust-item{padding:22px;}
  .reb-solutions{padding-top:70px!important;padding-bottom:42px!important;}
  .reb-markets{padding-top:70px!important;padding-bottom:70px!important;}
  .reb-platform-section .content_block_one .content-box,
  .reb-platform-section .video-box{margin-left:0!important;margin-right:0!important;}
  .reb-symbol-grid{grid-template-columns:1fr;}
  .reb-symbol-sync .reb-symbol-note{display:block;}
  .reb-symbol-note a{margin-top:16px;}
  .reb-process .image-box .image{min-height:360px;}
  .reb-apps .inner-container{padding:64px 26px 260px;}
  .reb-apps .image-layer{right:50%;transform:translateX(50%);bottom:18px;}
  .reb-apps .image-layer img{width:210px;}
  .reb-floating-cta{
    left:15px;
    right:15px;
    bottom:14px;
    justify-content:space-between;
    border-radius:8px;
  }
  .reb-floating-cta .reb-start{
    flex:1;
  }
  .reb-home{
    padding-bottom:76px;
  }
}
</style>


<style id="reach-exact-hero-layout-final">
@media (min-width: 1200px) {
  .reb-hero-visual{
    position:relative !important;
    min-height:560px !important;
  }
  .reb-feature-list{
    position:absolute !important;
    right:0 !important;
    top:18px !important;
    z-index:9 !important;
    width:min(330px, 72%) !important;
  }
  .reb-robot{
    position:absolute !important;
    left:-300px !important;
    bottom:96px !important;
    width:min(430px, 82%) !important;
    z-index:3 !important;
  }
  .reb-chart-card{
    position:absolute !important;
    right:6px !important;
    top:268px !important;
    bottom:auto !important;
    width:330px !important;
    min-height:218px !important;
    max-height:218px !important;
    padding:14px 14px 12px !important;
    z-index:10 !important;
    overflow:hidden !important;
  }
  .reb-chart-card span{
    margin-bottom:8px !important;
    font-size:13px !important;
  }
  .reb-chart-line,
  .reb-market-watch-widget,
  .reb-market-watch-widget .tradingview-widget-container,
  .reb-market-watch-widget .tradingview-widget-container__widget{
    height:160px !important;
    max-height:160px !important;
  }
  .reb-hero-contact{
    z-index:11 !important;
    bottom:26px !important;
  }
}
@media (min-width: 992px) and (max-width: 1199px) {
  .reb-robot{
    left:-210px !important;
    bottom:92px !important;
    width:min(390px, 82%) !important;
  }
  .reb-chart-card{
    right:0 !important;
    top:268px !important;
    width:320px !important;
    min-height:210px !important;
    max-height:210px !important;
  }
}
</style>


<style id="reach-balance-layout-fix">
@media (min-width: 1200px){

  /* Move robot slightly right closer to boxes */
  .reb-robot{
    left:-220px !important;
    bottom:92px !important;
    width:min(420px,82%) !important;
    z-index:4 !important;
  }

  /* Make Market Watch box same width style as top boxes */
  .reb-chart-card{
    right:0 !important;
    top:270px !important;
    width:284px !important;
    min-width:284px !important;
    max-width:284px !important;

    min-height:220px !important;
    max-height:220px !important;

    border-radius:14px !important;
    overflow:hidden !important;
    z-index:9 !important;
  }

  .reb-chart-card .reb-chart-line,
  .reb-chart-card .reb-market-watch-widget,
  .reb-chart-card .tradingview-widget-container,
  .reb-chart-card .tradingview-widget-container__widget{
    height:150px !important;
    max-height:150px !important;
  }

  .reb-feature-list{
    width:284px !important;
  }

}
</style>

</head>

