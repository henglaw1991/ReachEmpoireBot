    <!-- main-js -->
    <script src="assets/js/script.js"></script>
    <script>
    (function(){
      const ticker = document.getElementById('reb-live-ticker');
      if (!ticker) return;

      const fallbackQuotes = [
        {group:'Forex', label:'EUR/USD', price:1.08420, percent:0.12, decimals:5, live:false},
        {group:'Forex', label:'GBP/USD', price:1.26840, percent:-0.08, decimals:5, live:false},
        {group:'Forex', label:'USD/JPY', price:156.240, percent:0.05, decimals:3, live:false},
        {group:'Crypto', label:'BTC/USD', price:64250.00, percent:0.48, decimals:2, live:false},
        {group:'Crypto', label:'ETH/USD', price:3120.00, percent:-0.21, decimals:2, live:false},
        {group:'Metal', label:'XAU/USD', price:2358.40, percent:0.18, decimals:2, live:false},
        {group:'Metal', label:'XAG/USD', price:30.125, percent:-0.10, decimals:3, live:false}
      ];

      function formatPrice(item){
        if (typeof item.price !== 'number') return 'Updating';
        return item.price.toLocaleString('en-US', {
          minimumFractionDigits: item.decimals || 2,
          maximumFractionDigits: item.decimals || 2
        });
      }

      function render(items){
        const repeated = [];
        for (let i = 0; i < 4; i += 1) repeated.push.apply(repeated, items);
        ticker.innerHTML = repeated.map(function(item){
          const percent = typeof item.percent === 'number' ? item.percent : 0;
          const direction = percent >= 0 ? 'upper' : 'lower';
          const icon = percent >= 0 ? 'icon-06' : 'icon-05';
          const sign = percent >= 0 ? '+' : '';
          const status = item.live ? 'Live' : 'Preview';
          return '<li class="reb-market-tick '+direction+'"><strong>'+item.group+'</strong> '+item.label+
            ' <em>'+formatPrice(item)+'</em> <span>('+sign+percent.toFixed(2)+'% <i class="'+icon+'"></i>) '+status+'</span></li>';
        }).join('');
      }

      async function updateTicker(){
        try {
          const response = await fetch('/api/quotes', {cache:'no-store'});
          if (!response.ok) throw new Error('quotes unavailable');
          const data = await response.json();
          const liveItems = Array.isArray(data.items) ? data.items.filter(function(item){ return item.price !== null; }) : [];
          render(liveItems.length ? liveItems : fallbackQuotes);
        } catch (error) {
          render(fallbackQuotes);
        }
      }

      render(fallbackQuotes);
      updateTicker();
      setInterval(updateTicker, 30000);

      setTimeout(function(){
        const widget = document.querySelector('.reb-live-widget iframe');
        if (!widget) document.body.classList.add('reb-tv-fallback');
      }, 6000);
    })();
    </script>

    
</body>
